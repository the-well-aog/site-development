---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceStatus from '../components/ServiceStatus.astro';
import { site } from '../data/site';
import { img, url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Offer the "Be still" reading mode on this page. */
  still?: boolean;
}

const { title, description, image = img('church'), still = false } = Astro.props;
const fullTitle = title === 'Home' ? site.legal : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Absolute URLs and already-resolved site paths ("/…") pass through; bare paths get the base prefix.
const ogImage = /^https?:/.test(image) ? new URL(image) : new URL(image.startsWith('/') ? image : url(image), Astro.site);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: site.legal,
  description: site.tagline,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('images/the-well-logo.png'), Astro.site).href,
  telephone: site.phoneHref.replace('tel:', ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: site.locality,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: site.country,
  },
  ...(site.facebookPage ? { sameAs: [site.facebookPage] } : {}),
};
---

<!doctype html>
<html lang="en" data-still-page={still || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f3" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('images/the-well-logo-192.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('images/the-well-logo-192.png')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:site_name" content={site.legal} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {still && (
      <script is:inline>
        // Restore "Be still" before first paint, so the page doesn't flash light then dark.
        try { if (localStorage.getItem('thewell:still') === 'on') document.documentElement.dataset.still = ''; } catch {}
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <ServiceStatus />
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // A ripple from the point a button is pressed, like a drop on still water. Skipped for reduced motion.
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.addEventListener('pointerdown', (event) => {
        if (still.matches || !(event.target instanceof Element)) return;
        const target = event.target.closest<HTMLElement>('.button:not(.button-text), .planner-next, .respond-choice');
        if (!target) return;
        const box = target.getBoundingClientRect();
        const ink = document.createElement('span');
        ink.className = 'ink';
        ink.style.left = `${event.clientX - box.left}px`;
        ink.style.top = `${event.clientY - box.top}px`;
        target.append(ink);
        ink.addEventListener('animationend', () => ink.remove());
      });
    </script>
  </body>
</html>

