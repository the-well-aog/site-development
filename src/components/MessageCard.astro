---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { url } from '../lib/url';

interface Props {
  href: string;
  image: string;
  alt?: string;
  title: string;
  meta?: string;
  eyebrow?: string;
  summary?: string;
  video?: boolean;
  size?: 'md' | 'lg';
}

const { href, image, alt = '', title, meta, eyebrow, summary, video = false, size = 'md' } = Astro.props;
---

<a class:list={['message-card', `size-${size}`]} href={url(href)}>
  <div class="message-thumb tint">
    <Photo src={image} alt={alt} width={640} height={360} sizes={size === 'lg' ? '(min-width: 1000px) 60vw, 100vw' : '(min-width: 1000px) 30vw, (min-width: 620px) 50vw, 100vw'} />
    {video && <span class="message-play"><Icon name="play" size={size === 'lg' ? 22 : 16} /></span>}
  </div>
  <div class="message-body">
    {eyebrow && <p class="ref">{eyebrow}</p>}
    <h3>{title}</h3>
    {summary && <p class="message-summary">{summary}</p>}
    {meta && <p class="message-meta">{meta}</p>}
  </div>
</a>

<style>
  .message-card { display: grid; gap: 1rem; align-content: start; color: inherit; text-decoration: none; }
  .message-thumb { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--sand-2); aspect-ratio: 16 / 9; }
  .message-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .message-card:hover .message-thumb :global(img) { transform: scale(1.04); }
  .message-play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding-left: 3px;
    border-radius: 50%;
    background: rgb(0 46 74 / 70%);
    color: #fff;
    backdrop-filter: blur(6px);
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .size-lg .message-play { width: 4.5rem; height: 4.5rem; }
  .message-card:hover .message-play { transform: translate(-50%, -50%) scale(1.08); background: var(--navy); }
  .message-body { display: grid; gap: 0.45rem; }
  .message-body h3 { font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem); transition: color 0.2s var(--ease); }
  .size-lg .message-body h3 { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem); }
  .message-card:hover h3 { color: var(--accent); }
  .message-summary { color: var(--fg-muted); font-size: 0.95rem; }
  .message-meta { color: var(--fg-muted); font-size: 0.85rem; }
</style>
