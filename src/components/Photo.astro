---
import { Picture } from 'astro:assets';
import { localPhoto } from '../lib/url';

/*
  A photo by URL. Stock photos are served as AVIF/WebP at several widths so each screen
  downloads only what it shows; CMS uploads and YouTube thumbnails pass through as-is.
*/
interface Props {
  src: string;
  alt: string;
  /** How wide the photo is shown, for the browser to pick a size. */
  sizes?: string;
  width?: number;
  height?: number;
  priority?: boolean;
  class?: string;
  style?: string;
}

const { src, alt, sizes = '(min-width: 1000px) 50vw, 100vw', width = 1280, height = 853, priority = false, class: className, style } = Astro.props;
const local = localPhoto(src);
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
const widths = local ? [480, 800, 1200, local.width].filter((w, i, all) => w <= local.width && all.indexOf(w) === i) : [];
---

{local ? (
  <Picture src={local} alt={alt} widths={widths} sizes={sizes} formats={['avif', 'webp']} class={className} style={style} loading={loading} fetchpriority={fetchpriority} />
) : (
  <img src={src} alt={alt} width={width} height={height} class={className} style={style} loading={loading} fetchpriority={fetchpriority} decoding="async" />
)}
