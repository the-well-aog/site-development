---
import Button from './Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  lede?: string;
  action?: { href: string; label: string };
  align?: 'start' | 'center' | 'split';
  id?: string;
  as?: 'h1' | 'h2';
}

const { eyebrow, title, accent, lede, action, align = 'start', id, as: Heading = 'h2' } = Astro.props;
---

<header class:list={['section-header', `align-${align}`]} data-reveal>
  <div class="section-header-main">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading id={id}>{title}{accent && <><br /><em>{accent}</em></>}</Heading>
  </div>
  {(lede || action) && (
    <div class="section-header-side">
      {lede && <p class="lede">{lede}</p>}
      {action && <Button href={action.href} variant="text">{action.label}</Button>}
    </div>
  )}
</header>

<style>
  .section-header { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .section-header-main { display: grid; gap: 1rem; }
  .section-header-side { display: grid; gap: 1rem; justify-items: start; }
  .align-center { justify-items: center; text-align: center; }
  .align-center .section-header-main, .align-center .section-header-side { justify-items: center; }
  .align-center .lede { margin-inline: auto; }
  @media (min-width: 900px) {
    .align-split { grid-template-columns: 1.1fr 0.9fr; align-items: end; gap: 3rem; }
    .align-split .section-header-side { padding-bottom: 0.35rem; }
  }
</style>
