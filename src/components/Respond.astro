---
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { site } from '../data/site';

/*
  The altar, online: three ways to respond, each followed up by a person.
  With site.formEndpoint set, the visitor can send their name here and the form host forwards it;
  without it, they are pointed to a call or a Facebook message instead.
*/
interface Props {
  id?: string;
}

const { id = 'respond' } = Astro.props;
const live = Boolean(site.formEndpoint);

const choices: { key: string; icon: IconName; label: string; text: string; subject: string; thanks: string }[] = [
  {
    key: 'yes',
    icon: 'heart',
    label: 'I said yes to Jesus today',
    text: 'Heaven is rejoicing, and so are we. A pastor would love to welcome you, pray with you, and help you take your next steps.',
    subject: 'Respond: I said yes to Jesus',
    thanks: 'Welcome to the family. Someone from The Well will reach out this week, and we are already praying for you.',
  },
  {
    key: 'prayer',
    icon: 'hands',
    label: 'I would like prayer',
    text: 'You don’t need the perfect words. Tell us as much or as little as you like, and we will carry it to God with you.',
    subject: 'Respond: prayer request',
    thanks: 'Someone from The Well will be praying for you this week.',
  },
  {
    key: 'baptism',
    icon: 'flame',
    label: 'I want to be baptized',
    text: 'Water baptism is a public declaration that you belong to Jesus. A pastor will talk it through with you and tell you about the next baptism Sunday.',
    subject: 'Respond: baptism',
    thanks: 'We are so glad. A pastor will reach out about the next baptism Sunday.',
  },
];
---

<section class="respond tone-navy" id={id} aria-labelledby={`${id}-title`} data-respond>
  <svg class="respond-rings" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
    {[60, 120, 180, 240, 300].map((r) => <circle cx="300" cy="300" r={r} />)}
  </svg>
  <div class="wrap respond-inner">
    <div class="respond-head">
      <p class="eyebrow">Respond</p>
      <h2 id={`${id}-title`}>What is God stirring <em>in you?</em></h2>
      <p class="lede">There is no wrong way to respond. Choose what fits, and a real person from The Well will follow up with you.</p>
    </div>

    <div class="respond-choices" role="group" aria-label="How would you like to respond?">
      {choices.map((choice) => (
        <button class="respond-choice" type="button" aria-pressed="false" aria-controls={`${id}-${choice.key}`} data-respond-choice={choice.key}>
          <span class="respond-icon"><Icon name={choice.icon} size={22} /></span>
          <span>{choice.label}</span>
        </button>
      ))}
    </div>

    {choices.map((choice) => (
      <div class="respond-panel" id={`${id}-${choice.key}`} data-respond-panel={choice.key} hidden>
        <p class="respond-text">{choice.text}</p>
        {live ? (
          <form class="respond-form" action={site.formEndpoint} method="POST" data-respond-form>
            <input type="hidden" name="_subject" value={choice.subject} />
            <input type="hidden" name="response" value={choice.label} />
            <label>Your name<input name="name" autocomplete="name" required /></label>
            <label>Email or phone<input name="contact" autocomplete="email" required /></label>
            <label>Anything you’d like us to know (optional)<textarea name="message" rows="3"></textarea></label>
            <Button type="submit">Send</Button>
            <p class="respond-thanks" data-respond-thanks hidden role="status">{choice.thanks}</p>
            <p class="respond-error" data-respond-error hidden role="alert">That didn’t send. Please call us at {site.phoneDisplay}.</p>
          </form>
        ) : (
          <div class="respond-reach">
            <Button href={site.phoneHref} leading="phone" icon="none">Call {site.phoneDisplay}</Button>
            {site.facebookPage && <Button href={site.facebookPage} variant="secondary" leading="message" icon="none">Message us on Facebook</Button>}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .respond { position: relative; overflow: hidden; padding-block: var(--section); background: var(--bg); color: var(--fg); }
  .respond-rings { position: absolute; left: 50%; top: 0; width: min(60rem, 160vw); transform: translate(-50%, -35%); fill: none; stroke: #fff; stroke-opacity: 0.06; pointer-events: none; }
  .respond-inner { position: relative; display: grid; gap: clamp(1.75rem, 3vw, 2.5rem); justify-items: center; text-align: center; }
  .respond-head { display: grid; gap: 1rem; justify-items: center; }
  .respond-head .lede { margin-inline: auto; }
  .respond-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; width: min(100%, 60rem); }
  .respond-choice {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--heading);
    font: 500 1.1rem / 1.3 var(--serif);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .respond-choice:hover { border-color: var(--heading); transform: translateY(-2px); }
  .respond-choice[aria-pressed='true'] { background: var(--paper); border-color: var(--paper); color: var(--navy); }
  .respond-icon { display: grid; flex: none; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: rgb(255 255 255 / 10%); color: var(--accent-ink); }
  .respond-choice[aria-pressed='true'] .respond-icon { background: var(--navy); color: #fff; }
  .respond-panel { display: grid; gap: 1.25rem; justify-items: center; width: min(100%, 38rem); }
  .respond-text { color: var(--fg); font-size: var(--text-lg); }
  .respond-reach { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .respond-form { display: grid; gap: 1rem; width: 100%; text-align: left; }
  .respond-form label { display: grid; gap: 0.4rem; font-size: 0.85rem; font-weight: 500; color: var(--heading); }
  .respond-form input:not([type='hidden']), .respond-form textarea { width: 100%; padding: 0.8rem 0.95rem; border: 1px solid var(--line-strong); border-radius: 10px; background: rgb(255 255 255 / 6%); color: var(--heading); font-size: 1rem; }
  .respond-form input:focus, .respond-form textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .respond-form :global(.button) { justify-self: start; }
  .respond-thanks { padding: 1rem 1.15rem; border-left: 3px solid var(--gold); border-radius: 0 var(--radius) var(--radius) 0; background: var(--surface); color: var(--heading); font: italic 500 1.15rem / 1.45 var(--serif); }
  .respond-error { color: #f3c1b5; }
  @media (max-width: 800px) { .respond-choices { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-respond]').forEach((root) => {
    const choices = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-respond-choice]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-respond-panel]'));
    choices.forEach((choice) => {
      choice.addEventListener('click', () => {
        const key = choice.dataset.respondChoice;
        choices.forEach((other) => other.setAttribute('aria-pressed', String(other === choice)));
        panels.forEach((panel) => { panel.hidden = panel.dataset.respondPanel !== key; });
        root.querySelector<HTMLElement>(`[data-respond-panel="${key}"] input:not([type="hidden"]), [data-respond-panel="${key}"] a`)?.focus({ preventScroll: true });
      });
    });

    // Send in place so the visitor stays on the page and sees a personal thank-you.
    root.querySelectorAll<HTMLFormElement>('[data-respond-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const thanks = form.querySelector<HTMLElement>('[data-respond-thanks]');
        const error = form.querySelector<HTMLElement>('[data-respond-error]');
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (button) button.disabled = true;
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error(String(response.status));
          form.querySelectorAll<HTMLElement>('label, button').forEach((element) => { element.hidden = true; });
          if (thanks) thanks.hidden = false;
          if (error) error.hidden = true;
        } catch {
          if (error) error.hidden = false;
          if (button) button.disabled = false;
        }
      });
    });
  });
</script>
