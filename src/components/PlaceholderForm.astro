---
interface Props {
  submit: string;
}
const { submit } = Astro.props;
---

<div class="form-preview">
  <p class="form-availability"><span aria-hidden="true"></span> Form preview · not connected</p>
  <p class="fine form-explanation">This form is a preview. Messages cannot be entered or sent yet.</p>
  <form class="form" aria-label="Unavailable form preview">
    <fieldset disabled>
      <slot />
      <button class="btn" type="button" disabled>{submit} <span aria-hidden="true">↗</span></button>
    </fieldset>
  </form>
</div>

<style>
  .form-availability { display: flex; align-items: center; gap: .55rem; color: var(--tide); font-size: .78rem; font-weight: 500; }
  .form-availability > span { width: .42rem; height: .42rem; border-radius: 50%; background: currentColor; }
  .form-explanation { margin: .45rem 0 1.4rem; }
  fieldset { display: grid; gap: 1.1rem; min-width: 0; border: 0; margin: 0; padding: 0; }
  button { justify-self: start; margin-top: .5rem; cursor: not-allowed; opacity: .55; }
</style>
