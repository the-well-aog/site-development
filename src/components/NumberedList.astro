---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Scripture from './Scripture.astro';

export type NumberedItem = {
  id?: string;
  title: string;
  text: string;
  ref?: string;
  verse?: { text: string; reference: string };
  link?: { href: string; label: string };
};

interface Props {
  items: readonly NumberedItem[];
  as?: 'h2' | 'h3';
  /** Show a "taken this step" toggle on each item, remembered on the visitor's device. */
  track?: boolean;
}

const { items, as: Heading = 'h3', track = false } = Astro.props;
---

<ol class="numbered" role="list">
  {items.map((item, index) => (
    <li id={item.id} data-reveal>
      <div class="numbered-item">
        <span class="numbered-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="numbered-body">
          <Heading>{item.title}</Heading>
          <p>{item.text}</p>
          {item.ref && <p class="ref">{item.ref}</p>}
          {item.verse && <div class="numbered-verse"><Scripture text={item.verse.text} reference={item.verse.reference} /></div>}
          {(item.link || (track && item.id)) && (
            <div class="numbered-actions">
              {item.link && <Button href={item.link.href} variant="text">{item.link.label}</Button>}
              {track && item.id && (
                <button class="step-done" type="button" aria-pressed="false" data-step-toggle={item.id}>
                  <span class="step-box" aria-hidden="true"><Icon name="check" size={14} /></span>
                  <span>I’ve taken this step</span>
                </button>
              )}
            </div>
          )}
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .numbered { counter-reset: none; border-bottom: 1px solid var(--line); }
  li { border-top: 1px solid var(--line); }
  .numbered-item { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 0.5rem 1.5rem; padding: clamp(1.6rem, 3vw, 2.4rem) 0; }
  .numbered-num { font: italic 500 1.6rem / 1.2 var(--serif); color: var(--accent-ink); }
  .numbered-body { display: grid; gap: 0.75rem; justify-items: start; max-width: 66ch; }
  .numbered-body h2, .numbered-body h3 { font-size: clamp(1.5rem, 1.25rem + 1vw, 2.1rem); }
  .numbered-body > p:not(.ref) { color: var(--fg-muted); }
  .numbered-verse { width: 100%; margin-top: 0.25rem; padding: 1.1rem 1.25rem; border-left: 2px solid var(--accent-ink); background: var(--sand); border-radius: 0 var(--radius) var(--radius) 0; }
  .numbered-verse :global(blockquote p) { font-size: 1.15rem; }
  .numbered-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.75rem; }
  .step-done { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0; border: 0; background: none; color: var(--fg-muted); font-size: 0.92rem; cursor: pointer; }
  .step-box { display: grid; place-items: center; width: 1.4rem; height: 1.4rem; border: 1px solid var(--line-strong); border-radius: 6px; color: transparent; transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease); }
  .step-done[aria-pressed='true'] { color: var(--heading); }
  .step-done[aria-pressed='true'] .step-box { border-color: var(--gold); background: var(--gold); color: #fff; }
  @media (max-width: 620px) {
    .numbered-item { grid-template-columns: 1fr; }
  }
</style>
