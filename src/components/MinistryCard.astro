---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { photoFor, url } from '../lib/url';

interface Props {
  entry: CollectionEntry<'ministries'>;
}

const { entry } = Astro.props;
const { title, who, when, summary, alt } = entry.data;
---

<a class="ministry-card" href={url(`/ministries/${entry.id}`)}>
  <div class="ministry-photo">
    <img src={photoFor(entry.data)} alt={alt} width="800" height="600" loading="lazy" />
    <span class="ministry-tag">{who}</span>
  </div>
  <div class="ministry-body">
    <h3>{title}</h3>
    <p class="ministry-summary">{summary}</p>
    <p class="ministry-when"><Icon name="clock" size={16} />{when}</p>
  </div>
  <span class="ministry-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
</a>

<style>
  .ministry-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .ministry-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .ministry-photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand-2); }
  .ministry-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .ministry-card:hover .ministry-photo img { transform: scale(1.04); }
  .ministry-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgb(250 248 243 / 92%);
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 500;
    backdrop-filter: blur(6px);
  }
  .ministry-body { display: grid; gap: 0.6rem; padding: 1.4rem 1.5rem 1.6rem; padding-right: 4.5rem; }
  .ministry-body h3 { font-size: 1.6rem; }
  .ministry-summary { color: var(--fg-muted); font-size: 0.95rem; }
  .ministry-when { display: flex; align-items: center; gap: 0.45rem; color: var(--fg); font-size: 0.88rem; font-weight: 500; }
  .ministry-when :global(.icon) { color: var(--accent-ink); flex: none; }
  .ministry-arrow {
    position: absolute;
    right: 1.4rem;
    bottom: 1.5rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--heading);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .ministry-card:hover .ministry-arrow { background: var(--navy); border-color: var(--navy); color: #fff; }
</style>
