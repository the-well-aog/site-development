---
import { isActive, url } from '../lib/url';

const groups = [
  { label: 'About', id: 'about', links: [['/about', 'Our story'], ['/beliefs', 'What we believe'], ['/leadership', 'Our leadership']] },
  { label: 'Connect', id: 'connect', links: [['/ministries', 'Ministries'], ['/next-steps', 'Next steps'], ['/prayer', 'Prayer'], ['/contact', 'Contact us']] },
];
const links = [['/sermons', 'Watch'], ['/events', 'Events'], ['/give', 'Give']];
const active = (href: string) => isActive(Astro.url.pathname, href) ? 'page' : undefined;
---

<header class="site-header" data-header>
  <div class="header-bar">
    <a class="brand-home" href={url('/')} aria-label="The Well Assembly of God — home">
      <img src={url('images/the-well-logo.png')} width="1254" height="1254" alt="The Well Assembly of God" loading="eager" />
    </a>
    <nav class="nav-desktop" aria-label="Primary">
      {groups.map((group) => (
        <div class="nav-group" data-nav-group>
          <button class="nav-disclosure" type="button" aria-expanded="false" aria-controls={`nav-${group.id}`} data-nav-disclosure data-active={group.links.some(([href]) => active(href)) || undefined}>
            {group.label}<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
          </button>
          <div class="nav-dropdown" id={`nav-${group.id}`} hidden>
            {group.links.map(([href, label]) => <a href={url(href)} aria-current={active(href)}>{label}<span aria-hidden="true">↗</span></a>)}
          </div>
        </div>
      ))}
      {links.map(([href, label]) => <a class="nav-link" href={url(href)} aria-current={active(href)}>{label}</a>)}
      <a class="btn visit-link" href={url('/visit')} aria-current={active('/visit')}>Plan your visit <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="mobile-controls">
      <a class="mobile-visit" href={url('/visit')}>Plan a visit <span aria-hidden="true">↗</span></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
        <span class="sr" data-nav-label>Open menu</span>
      </button>
    </div>
  </div>
  <nav id="nav-panel" class="nav-panel" aria-label="Mobile" hidden>
    <div class="mobile-welcome"><span class="eyebrow">You belong here</span><a href={url('/visit')}>Come as you are. <span aria-hidden="true">↗</span></a></div>
    <div class="mobile-nav-groups">
      {groups.map((group) => (
        <div class="mobile-nav-group">
          <h2>{group.label}</h2>
          {group.links.map(([href, label]) => <a href={url(href)} aria-current={active(href)}>{label}</a>)}
        </div>
      ))}
    </div>
    <div class="mobile-quick-links">
      {links.map(([href, label]) => <a href={url(href)} aria-current={active(href)}>{label}<span aria-hidden="true">↗</span></a>)}
      <a href={url('/live')} aria-current={active('/live')}>Livestream<span aria-hidden="true">↗</span></a>
    </div>
    <p class="mobile-signoff">Faith. Community. A place to call home.</p>
  </nav>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 40; height: var(--header, 104px); background: var(--paper, #faf8f2); border-bottom: 1px solid var(--line); color: var(--well, #002e4a); }
  .site-header.is-scrolled { box-shadow: 0 4px 22px rgb(0 46 74 / 5%); }
  .header-bar { width: min(1320px, calc(100% - 4rem)); height: 100%; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand-home { display: flex; flex: none; align-items: center; text-decoration: none; }
  .brand-home img { width: 92px; height: 92px; object-fit: contain; }
  .nav-desktop { display: flex; align-items: center; gap: clamp(1.3rem, 2.4vw, 2.6rem); height: 100%; }
  .nav-group { position: relative; }
  .nav-disclosure { display: inline-flex; align-items: center; gap: .5rem; font: inherit; font-size: .92rem; font-weight: 500; color: inherit; border: 0; background: none; padding: .7rem 0; cursor: pointer; }
  .nav-disclosure svg { fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform .2s; }
  .nav-disclosure[aria-expanded='true'] svg { transform: rotate(180deg); }
  .nav-disclosure[data-active], .nav-link[aria-current] { text-decoration: underline; text-underline-offset: .4em; }
  .nav-link { padding: .7rem 0; font-size: .92rem; font-weight: 500; text-decoration: none; }
  .nav-link:hover, .nav-disclosure:hover { color: var(--tide); }
  .visit-link { gap: 1.6rem; min-height: 46px; font-size: .88rem; padding-inline: 1.25rem; color: var(--paper); }
  .nav-dropdown { position: absolute; top: calc(100% + 1rem); left: -1.25rem; min-width: 235px; padding: .6rem; border: 1px solid var(--line); background: var(--paper); border-radius: .6rem; box-shadow: 0 16px 36px rgb(0 46 74 / 12%); }
  .nav-dropdown a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem .8rem; border-radius: .3rem; font-size: .92rem; text-decoration: none; }
  .nav-dropdown a:hover, .nav-dropdown a:focus-visible { background: var(--paper-2); }
  .nav-dropdown a[aria-current] { text-decoration: underline; text-underline-offset: .3em; }
  .nav-dropdown a span { color: var(--tide); }
  .mobile-controls, .nav-panel { display: none; }
  @media (max-width: 980px) {
    .header-bar { width: calc(100% - 2rem); }
    .brand-home img { width: 76px; height: 76px; }
    .nav-desktop { display: none; }
    .mobile-controls { display: flex; align-items: center; gap: .85rem; }
    .mobile-visit { display: inline-flex; align-items: center; gap: .8rem; font-size: .82rem; font-weight: 500; text-decoration: none; padding: .7rem 0; }
    .nav-toggle { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: inherit; background: var(--paper-2); border: 1px solid var(--line); cursor: pointer; }
    .menu-lines { position: relative; display: block; width: 17px; height: 12px; }
    .menu-lines span { position: absolute; width: 17px; height: 1.5px; background: currentColor; left: 0; top: 3px; transition: transform .2s, top .2s; }
    .menu-lines span:last-child { top: 9px; }
    .site-header.is-open .menu-lines span { top: 6px; transform: rotate(45deg); }
    .site-header.is-open .menu-lines span:last-child { transform: rotate(-45deg); }
    .site-header.is-open .nav-panel { display: flex; flex-direction: column; position: fixed; inset: var(--header) 0 0; overflow: auto; color: var(--ink); padding: 1.5rem max(1.25rem, calc((100vw - 650px) / 2)) calc(2rem + env(safe-area-inset-bottom)); background: var(--paper); overscroll-behavior: contain; }
    .mobile-welcome { border-bottom: 1px solid var(--line); padding-bottom: 1.2rem; margin-bottom: 1.2rem; }
    .mobile-welcome .eyebrow { display: block; margin-bottom: .25rem; font-size: .65rem; }
    .mobile-welcome a { display: flex; align-items: center; justify-content: space-between; font-family: var(--serif); font-size: clamp(1.8rem, 5vw, 2.5rem); line-height: 1.2; padding: .4rem 0; text-decoration: none; }
    .mobile-nav-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .mobile-nav-group h2 { font-family: var(--sans); font-size: .68rem; font-weight: 500; text-transform: uppercase; letter-spacing: .13em; color: var(--muted); margin-bottom: .35rem; }
    .mobile-nav-group a { display: block; font-size: 1rem; font-weight: 400; padding: .7rem 0; text-decoration: none; }
    .nav-panel a[aria-current='page'] { text-decoration: underline; text-underline-offset: .3em; }
    .mobile-quick-links { margin-top: 1.25rem; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
    .mobile-quick-links a { display: flex; align-items: center; justify-content: space-between; font-size: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
    .mobile-quick-links a span { font-size: .8rem; }
    .mobile-signoff { margin-top: 1.5rem; font-size: .8rem; color: var(--muted); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('#nav-panel');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');
  const desktop = window.matchMedia('(min-width: 981px)');
  const disclosures = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-nav-disclosure]'));

  function closeDropdowns(except?: HTMLButtonElement) {
    disclosures.forEach((button) => {
      if (button === except) return;
      button.setAttribute('aria-expanded', 'false');
      const dropdown = document.getElementById(button.getAttribute('aria-controls') || '');
      if (dropdown) dropdown.hidden = true;
    });
  }

  disclosures.forEach((button) => {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      closeDropdowns(button);
      button.setAttribute('aria-expanded', String(open));
      const dropdown = document.getElementById(button.getAttribute('aria-controls') || '');
      if (dropdown) dropdown.hidden = !open;
    });
    button.closest('[data-nav-group]')?.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget;
      if (!(next instanceof Node) || !button.closest('[data-nav-group]')?.contains(next)) closeDropdowns();
    });
  });

  function setOpen(open: boolean, restoreFocus = false) {
    if (!header || !toggle || !panel) return;
    header.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    document.querySelectorAll<HTMLElement>('main, .site-footer').forEach((element) => { element.inert = open; });
    if (open) {
      closeDropdowns();
      panel.querySelector<HTMLAnchorElement>('a')?.focus();
    } else if (restoreFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && !event.target.closest('[data-nav-group]')) closeDropdowns();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const opened = disclosures.find((button) => button.getAttribute('aria-expanded') === 'true');
      closeDropdowns();
      opened?.focus();
      if (toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    }
    if (event.key === 'Tab' && toggle?.getAttribute('aria-expanded') === 'true' && header) {
      const focusable = Array.from(header.querySelectorAll<HTMLElement>('a[href], button')).filter((element) => element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
  desktop.addEventListener('change', () => {
    const hadFocus = header?.contains(document.activeElement);
    setOpen(false);
    closeDropdowns();
    if (hadFocus) {
      if (desktop.matches) header?.querySelector<HTMLAnchorElement>('.brand-home')?.focus();
      else toggle?.focus();
    }
  });
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
