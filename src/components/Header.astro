---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getNav } from '../data/nav';
import { site } from '../data/site';
import { isActive, url } from '../lib/url';

const { groups, links, cta } = await getNav();
const here = Astro.url.pathname;
const current = (href: string) => (isActive(here, href) && !href.includes('#') ? 'page' : undefined);
const withOverview = groups.map((group) => ({
  ...group,
  overview: group.links.some((link) => link.href === group.href) ? null : { href: group.href, label: `All ${group.label.toLowerCase()}` },
}));
---

<header class="site-header" data-header>
  <div class="header-bar">
    <a class="brand" href={url('/')} aria-label={`${site.legal}, home`}>
      <img src={url('images/the-well-logo-192.png')} width="192" height="192" alt="" />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul role="list">
        {withOverview.map((group) => (
          <li class="nav-group" data-nav-group>
            <button class="nav-item" type="button" aria-expanded="false" aria-controls={`menu-${group.id}`} data-nav-trigger data-current={group.links.some((link) => current(link.href)) || undefined}>
              {group.label}<Icon name="chevron-down" size={14} class="nav-chevron" />
            </button>
            <div class="nav-menu" id={`menu-${group.id}`} hidden>
              <ul role="list">
                {group.links.map((link) => (
                  <li>
                    <a href={url(link.href)} aria-current={current(link.href)}>
                      <strong>{link.label}</strong>
                      {link.note && <span>{link.note}</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {group.overview && <a class="nav-menu-overview" href={url(group.overview.href)}>{group.overview.label}<Icon name="arrow-right" size={16} /></a>}
            </div>
          </li>
        ))}
        {links.map((link) => (
          <li><a class="nav-item" href={url(link.href)} aria-current={current(link.href)}>{link.label}</a></li>
        ))}
      </ul>
      <Button href={cta.href}>{cta.label}</Button>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="menu-label" data-menu-label>Menu</span>
      <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Main menu" hidden>
    <div class="mobile-inner">
      <div class="mobile-groups">
        {withOverview.map((group) => (
          <div class="mobile-group">
            <p class="mobile-group-label">{group.label}</p>
            <ul role="list">
              {group.links.map((link) => <li><a href={url(link.href)} aria-current={current(link.href)}>{link.label}</a></li>)}
              {group.overview && <li><a href={url(group.overview.href)}>{group.overview.label}</a></li>}
            </ul>
          </div>
        ))}
        <div class="mobile-group">
          <p class="mobile-group-label">More</p>
          <ul role="list">
            {links.map((link) => <li><a href={url(link.href)} aria-current={current(link.href)}>{link.label}</a></li>)}
            <li><a href={url('/contact')} aria-current={current('/contact')}>Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="mobile-footer">
        <ul class="mobile-times" role="list">
          {site.services.map((service) => <li><span>{service.day}</span><strong>{service.time}</strong><em>{service.name}</em></li>)}
        </ul>
        <Button href={cta.href} size="lg" class="mobile-cta">{cta.label}</Button>
        <div class="mobile-quick">
          <a href={site.phoneHref}><Icon name="phone" size={18} />Call</a>
          <a href={site.mapsHref}><Icon name="pin" size={18} />Directions</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 248 243 / 88%);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); box-shadow: 0 6px 24px rgb(0 46 74 / 5%); }
  /* backdrop-filter makes the header the containing block for fixed children; drop it while the menu is open. */
  .site-header.is-open { background: var(--paper); backdrop-filter: none; -webkit-backdrop-filter: none; border-bottom-color: var(--line); }
  .header-bar {
    width: min(1320px, 100% - 2 * var(--gutter));
    height: var(--header-h);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand { display: block; flex: none; border-radius: 8px; }
  .brand img { width: 62px; height: 62px; object-fit: contain; }

  .nav-desktop { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); }
  .nav-desktop > ul { display: flex; align-items: center; gap: clamp(0.25rem, 1vw, 0.75rem); }
  .nav-group { position: relative; }
  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 0.7rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .nav-item:hover, .nav-item[aria-expanded='true'] { background: var(--sand); }
  .nav-item[aria-current], .nav-item[data-current] { color: var(--navy); box-shadow: inset 0 -2px 0 var(--gold); border-radius: 0; }
  .nav-item :global(.nav-chevron) { transition: transform 0.2s var(--ease); opacity: 0.7; }
  .nav-item[aria-expanded='true'] :global(.nav-chevron) { transform: rotate(180deg); }

  .nav-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    width: 21rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow-md);
    transform: translateX(-50%);
    animation: menu-in 0.18s var(--ease);
  }
  .nav-menu::before { content: ''; position: absolute; inset: -0.75rem 0 auto; height: 0.75rem; }
  .nav-menu a { display: grid; gap: 0.1rem; padding: 0.75rem 0.9rem; border-radius: 10px; text-decoration: none; }
  .nav-menu a:hover, .nav-menu a:focus-visible { background: var(--sand); }
  .nav-menu strong { font-weight: 500; color: var(--navy); }
  .nav-menu a span { color: var(--muted); font-size: 0.85rem; line-height: 1.4; }
  .nav-menu a[aria-current] strong { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 0.3em; }
  .nav-menu-overview { display: flex !important; grid-template-columns: none; align-items: center; justify-content: space-between; margin-top: 0.25rem; border-top: 1px solid var(--line); border-radius: 0 0 10px 10px !important; color: var(--navy); font-size: 0.9rem; font-weight: 500; }
  @keyframes menu-in { from { opacity: 0; transform: translate(-50%, -6px); } }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0 0.4rem 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--paper);
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }
  .menu-lines { position: relative; display: block; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--navy); }
  .menu-lines span { position: absolute; left: 0.65rem; width: 0.8rem; height: 1.5px; background: #fff; transition: transform 0.25s var(--ease), top 0.25s var(--ease); }
  .menu-lines span:first-child { top: 0.85rem; }
  .menu-lines span:last-child { top: 1.15rem; }
  .is-open .menu-lines span:first-child { top: 1rem; transform: rotate(45deg); }
  .is-open .menu-lines span:last-child { top: 1rem; transform: rotate(-45deg); }

  .mobile-menu { display: none; }

  @media (max-width: 1000px) {
    .nav-desktop { display: none; }
    .menu-toggle { display: inline-flex; }
    .brand img { width: 52px; height: 52px; }
    .is-open .mobile-menu {
      display: block;
      position: fixed;
      inset: var(--header-h) 0 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--paper);
      animation: sheet-in 0.25s var(--ease);
    }
    .mobile-inner {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
      width: min(640px, 100% - 2 * var(--gutter));
      margin-inline: auto;
      padding: 1.5rem 0 calc(1.5rem + env(safe-area-inset-bottom));
    }
    .mobile-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem 1.5rem; }
    .mobile-group-label { margin-bottom: 0.35rem; font: 600 0.7rem / 1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
    .mobile-group a { display: block; padding: 0.55rem 0; font: 500 1.2rem / 1.3 var(--serif); color: var(--navy); text-decoration: none; }
    .mobile-group a[aria-current] { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 0.3em; }
    .mobile-footer { display: grid; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
    .mobile-times { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1.5rem; }
    .mobile-times li { display: grid; }
    .mobile-times em { font-style: normal; font-size: 0.85rem; color: var(--muted); }
    .mobile-times span { font: 600 0.68rem / 1.4 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
    .mobile-times strong { font: 500 1.35rem / 1.2 var(--serif); color: var(--navy); }
    .mobile-footer :global(.mobile-cta) { width: 100%; }
    .mobile-quick { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .mobile-quick a { display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 48px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--navy); font-weight: 500; text-decoration: none; }
  }
  @media (max-width: 380px) {
    .menu-label { display: none; }
    .menu-toggle { padding-left: 0.4rem; }
  }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(-8px); } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const panel = document.getElementById('mobile-menu');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-nav-trigger]'));
  const desktop = window.matchMedia('(min-width: 1001px)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  const menuFor = (trigger: HTMLButtonElement) => document.getElementById(trigger.getAttribute('aria-controls') || '');

  function setMenu(trigger: HTMLButtonElement, open: boolean) {
    trigger.setAttribute('aria-expanded', String(open));
    const menu = menuFor(trigger);
    if (menu) menu.hidden = !open;
  }

  function closeMenus(except?: HTMLButtonElement) {
    triggers.forEach((trigger) => { if (trigger !== except) setMenu(trigger, false); });
  }

  triggers.forEach((trigger) => {
    const group = trigger.closest<HTMLElement>('[data-nav-group]');
    let timer: number | undefined;
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeMenus(trigger);
      setMenu(trigger, open);
    });
    group?.addEventListener('pointerenter', () => {
      if (!finePointer.matches) return;
      window.clearTimeout(timer);
      closeMenus(trigger);
      setMenu(trigger, true);
    });
    group?.addEventListener('pointerleave', () => {
      if (!finePointer.matches) return;
      timer = window.setTimeout(() => setMenu(trigger, false), 160);
    });
    group?.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget;
      if (!(next instanceof Node) || !group.contains(next)) setMenu(trigger, false);
    });
  });

  function setOpen(open: boolean, restoreFocus = false) {
    if (!header || !toggle || !panel) return;
    header.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (label) label.textContent = open ? 'Close' : 'Menu';
    document.querySelectorAll<HTMLElement>('main, .site-footer').forEach((element) => { element.inert = open; });
    if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (restoreFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && !event.target.closest('[data-nav-group]')) closeMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const opened = triggers.find((trigger) => trigger.getAttribute('aria-expanded') === 'true');
      closeMenus();
      opened?.focus();
      if (toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    }
    if (event.key === 'Tab' && toggle?.getAttribute('aria-expanded') === 'true' && header) {
      const focusable = Array.from(header.querySelectorAll<HTMLElement>('a[href], button')).filter((element) => element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });

  desktop.addEventListener('change', () => { setOpen(false); closeMenus(); });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
