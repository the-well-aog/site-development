---
import Clock from './Clock.astro';
import { site } from '../data/site';

interface Props {
  variant?: 'compact' | 'cards';
  days?: string[];
}

const { variant = 'compact', days } = Astro.props;
const services = days ? site.services.filter((service) => days.includes(service.day)) : site.services;
---

<dl class:list={['service-times', `variant-${variant}`]}>
  {services.map((service) => (
    <div class="service">
      <dt>{service.day}<span class="sr-only">, {service.name}</span></dt>
      <dd class="service-time"><Clock time={service.time} /></dd>
      <dd class="service-name">{service.name}</dd>
      {variant === 'cards' && <dd class="service-detail">{service.detail}</dd>}
    </div>
  ))}
</dl>

<style>
  .service-times { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr)); gap: 1rem 1.5rem; }
  .service { display: grid; align-content: start; gap: 0.1rem; padding-top: 0.9rem; border-top: 1px solid var(--line-strong); }
  dt { font: 600 0.7rem / 1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-muted); }
  .service-time { font: 500 2rem / 1.15 var(--serif); letter-spacing: -0.03em; color: var(--heading); }
  .service-name { color: var(--fg); font-size: 0.95rem; font-weight: 500; }
  .service-detail { color: var(--fg-muted); font-size: 0.9rem; }

  .variant-cards { grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr)); gap: 0.75rem; }
  .variant-cards .service {
    gap: 0.25rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .variant-cards .service-time { margin-top: 0.15rem; font-size: clamp(2.25rem, 2rem + 1vw, 2.75rem); }
  .variant-cards .service-name { margin-top: 0.25rem; font: 500 1.15rem / 1.3 var(--serif); color: var(--heading); }
  @media (max-width: 560px) {
    .variant-cards .service { padding: 1.1rem; }
    .variant-cards .service-time { font-size: 2rem; }
    .variant-cards .service-name { font-size: 1.05rem; }
    .variant-cards .service-detail { font-size: 0.82rem; }
  }
</style>
