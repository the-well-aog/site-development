---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

/*
  A third-party frame (Google Maps, Facebook) that loads only when asked.
  Blocked or slow embeds otherwise leave a blank box; this keeps a designed placeholder
  in its place, and nothing is requested from the third party until the visitor opts in.
*/
interface Props {
  src: string;
  title: string;
  label: string;
  icon?: IconName;
  allow?: string;
  referrerpolicy?: string;
  class?: string;
}

const { src, title, label, icon = 'play', allow, referrerpolicy = 'strict-origin-when-cross-origin', class: className } = Astro.props;
---

<div class:list={['embed', className]} data-embed>
  <div class="embed-placeholder" data-embed-placeholder>
    <slot />
    <button class="embed-load" type="button" data-embed-load>
      <Icon name={icon} size={16} />{label}
    </button>
  </div>
  <template data-embed-template>
    <iframe src={src} title={title} allow={allow} referrerpolicy={referrerpolicy} allowfullscreen></iframe>
  </template>
</div>

<style>
  .embed { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
  .embed-placeholder { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 1rem; padding: 1.5rem; text-align: center; }
  .embed :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .embed-load {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg);
    color: var(--heading);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .embed-load:hover { background: var(--heading); border-color: var(--heading); color: var(--bg); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((embed) => {
    const button = embed.querySelector<HTMLButtonElement>('[data-embed-load]');
    const template = embed.querySelector<HTMLTemplateElement>('[data-embed-template]');
    button?.addEventListener('click', () => {
      if (!template) return;
      const frame = template.content.firstElementChild?.cloneNode(true);
      if (!(frame instanceof HTMLIFrameElement)) return;
      embed.querySelector('[data-embed-placeholder]')?.remove();
      embed.append(frame);
      frame.focus();
    });
  });
</script>
