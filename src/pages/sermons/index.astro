---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { isPlaceholderText } from '../../data/copy';
import { loadSocial } from '../../lib/feeds';
import { longDate } from '../../lib/format';
import { img, url } from '../../lib/url';

const sermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const series = [...new Set(sermons.map((entry) => entry.data.series))];
const social = await loadSocial();
const videos = social.videos;
---

<Base title="Sermons" description="Bible-centered messages from The Well Assembly of God. Watch the latest service or read the notes from a series." image="images/night.jpg">
  <PageHero
    kicker="Watch & listen"
    title="A word for your week."
    deck="Bible-centered preaching for everyday life. Catch up on a message, revisit a passage, or share one with a friend."
  />
  {videos.length > 0 && (
    <section class="section" style="padding-top: 0.4rem;" aria-labelledby="latest-title">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">Latest services</p><h2 id="latest-title" class="block-title">Watch online.</h2></div>{social.channelUrl && <a class="more" href={social.channelUrl}>YouTube channel <span aria-hidden="true">↗</span></a>}</div>
        <div class="sermon-grid">
          {videos.map((video) => (
            <a class="sermon-card" href={url(`/watch/${video.id}`)}>
              <img src={video.thumbnail} alt="" loading="lazy" width="480" height="360" />
              <h3 class="card-title">{video.title}</h3>
              <p class="fine" style="margin-top: 0.4rem;">{longDate(new Date(video.published))}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  {sermons.length > 0 && (
    <section class="section" style={videos.length > 0 ? 'padding-top: 0;' : 'padding-top: 0.4rem;'} aria-labelledby="notes-title">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">{series.length === 1 ? `Series · ${series[0]}` : 'Message notes'}</p><h2 id="notes-title" class="block-title">Read and reflect.</h2></div></div>
        {sermons.some((entry) => isPlaceholderText(entry.data.summary)) && <p class="fine" style="margin-bottom: 1rem;">This library includes sample entries for the website preview.</p>}
        {series.length > 1 && <p class="meta-row" style="margin-top: 0; margin-bottom: 1.6rem;">{series.map((name) => <span>{name}</span>)}</p>}
        <div class="sermon-grid">
          {sermons.map((entry) => (
            <a class="sermon-card" href={url(`/sermons/${entry.id}`)}>
              <img src={img(entry.data.image)} alt={entry.data.alt} loading="lazy" />
              <p class="eyebrow" style="margin-top: 0.9rem;">{entry.data.passage}</p>
              <h3 class="card-title">{entry.data.title}</h3>
              {!isPlaceholderText(entry.data.summary) && <p class="sermon-summary">{entry.data.summary}</p>}
              <p class="fine" style="margin-top: 0.4rem;">{longDate(entry.data.date)} · {entry.data.speaker}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="band-dark"><div class="wrap"><p class="eyebrow light">Join us online</p><h2 class="block-title">Worship with us live.</h2><p class="deck" style="color: rgba(243,239,230,.82); margin-top: 1rem;">Can’t be in the room? Join the service online and worship with us wherever you are.</p><div class="actions"><a class="btn btn-light" href={url('/live')}>Watch live <span aria-hidden="true">→</span></a></div></div></section>
</Base>

<style>
  .sermon-summary { margin-top: .5rem; color: var(--muted); font-size: .95rem; }
  .sermon-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 980px) { .sermon-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .sermon-grid { grid-template-columns: 1fr; } }
</style>
