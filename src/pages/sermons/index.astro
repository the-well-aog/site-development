---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { isPlaceholderText } from '../../data/copy';
import { loadSocial } from '../../lib/feeds';
import { longDate } from '../../lib/format';
import { img, url } from '../../lib/url';

const sermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const series = [...new Set(sermons.map((entry) => entry.data.series))];
const social = await loadSocial();
const videos = social.videos;
---

<Base title="Sermons" description="Messages from The Well Assembly of God." image="images/night.jpg">
  <PageHero
    kicker="Watch"
    title="A message for your week."
    deck="Catch up on a message, revisit a passage, or take a little time to listen and reflect."
  />
  <section class="section" style="padding-top: 0.4rem;">
    <div class="wrap">
      {
        videos.length > 0 ? (
          <div class="sermon-grid">
            {
              videos.map((video) => (
                <a class="sermon-card" href={url(`/watch/${video.id}`)}>
                  <img src={video.thumbnail} alt="" loading="lazy" width="480" height="360" />
                  <h2 class="card-title">{video.title}</h2>
                  <p class="fine" style="margin-top: 0.4rem;">{longDate(new Date(video.published))}</p>
                </a>
              ))
            }
          </div>
        ) : (
          <>
            {sermons.some((entry) => isPlaceholderText(entry.data.summary)) && <p class="fine" style="margin-bottom: 1rem;">This message library includes sample entries for the website preview. Recordings are not connected yet.</p>}
            <p class="meta-row" style="margin-top: 0; margin-bottom: 1.6rem;">
              {series.map((name) => <span>{name}</span>)}
            </p>
            <div class="sermon-grid">
              {
                sermons.map((entry) => (
                  <a class="sermon-card" href={url(`/sermons/${entry.id}`)}>
                    <img src={img(entry.data.image)} alt={entry.data.alt} loading="lazy" />
                    <p class="eyebrow" style="margin-top: 0.9rem;">{entry.data.series}</p>
                    <h2 class="card-title">{entry.data.title}</h2>
                    <p class="fine" style="margin-top: 0.4rem;">
                      {longDate(entry.data.date)} · {entry.data.speaker}
                    </p>
                  </a>
                ))
              }
            </div>
          </>
        )
      }
    </div>
  </section>
  <section class="band-dark"><div class="wrap"><p class="eyebrow light">Join us online</p><h2 class="block-title">Looking for the livestream?</h2><div class="actions"><a class="btn btn-light" href={url('/live')}>Watch live <span aria-hidden="true">→</span></a></div></div></section>
</Base>
