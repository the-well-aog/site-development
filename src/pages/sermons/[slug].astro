---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MessageCard from '../../components/MessageCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { longDate } from '../../lib/format';
import { img } from '../../lib/url';

export async function getStaticPaths() {
  const sermons = await getCollection('sermons');
  return sermons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'sermons'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const series = (await getCollection('sermons'))
  .filter((other) => other.data.series === entry.data.series && other.id !== entry.id)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<Base title={entry.data.title} description={entry.data.summary} image={`images/${entry.data.image}.jpg`}>
  <PageHeader
    back={{ href: '/watch', label: 'All messages' }}
    eyebrow={`${entry.data.series} · ${entry.data.passage}`}
    title={entry.data.title}
    lede={entry.data.summary}
    image={entry.data.video ? undefined : { src: img(entry.data.image), alt: entry.data.alt }}
  >
    <Fragment slot="meta"><span>{longDate(entry.data.date)}</span><span>{entry.data.speaker}</span></Fragment>
  </PageHeader>

  {entry.data.video && (
    <Section space="flush-top" width="wide"><VideoEmbed id={entry.data.video} title={entry.data.title} eager /></Section>
  )}

  <Section width="narrow">
    <div class="prose"><Content /></div>
  </Section>

  {series.length > 0 && (
    <Section tone="sand" width="wide" labelledby="series-title">
      <SectionHeader id="series-title" eyebrow={`Series · ${entry.data.series}`} title="More in this series." action={{ href: '/watch', label: 'All messages' }} align="split" />
      <ul class="grid" role="list">
        {series.map((other) => <li><MessageCard href={`/sermons/${other.id}`} image={img(other.data.image)} alt={other.data.alt} eyebrow={other.data.passage} title={other.data.title} meta={longDate(other.data.date)} /></li>)}
      </ul>
    </Section>
  )}
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } }
</style>
