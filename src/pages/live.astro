---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { loadSocial } from '../lib/feeds';
import { img, url } from '../lib/url';

const social = await loadSocial();
---

<Base title="Livestream" description="Watch The Well Assembly of God when you cannot be in the room." image="images/night.jpg">
  <section class="live">
    <img src={img('night')} alt="People seated in silhouette around a stone basin in evening light." style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
    <div class="live-scrim"></div>
    <div class="wrap">
      <p class="eyebrow light">Watch live</p>
      <h1>Wherever you are,<br />join us here.</h1>
      <p class="deck" style="color: rgba(243,239,230,0.86); margin: 1rem 0 1.4rem;">Make a little room for worship, a message, and time to reflect.</p>
      <p class="fine" style="color: rgba(243,239,230,.8);">{site.sundayLabel} · {site.sundayTime} <span style="opacity: .8;">— sample gathering time</span></p>
      <div class="actions">
        {
          social.channelId ? (
            <a class="btn btn-light" href="#service">Watch the service</a>
          ) : (
            <span class="fine" style="color: inherit;">The livestream is not connected yet.</span>
          )
        }
        <a class="btn btn-ghost" href={url('/sermons')}>Past messages</a>
      </div>
    </div>
  </section>
  {
    social.channelId ? (
      <section class="section" id="service">
        <div class="wrap">
          <p class="eyebrow">Join the service</p>
          <h2 class="block-title">Watch together.</h2>
          <div class="video-embed" style="margin-top: 1.4rem;">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/live_stream?channel=${social.channelId}`}
              title="Livestream"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </div>
          <p class="fine" style="margin-top: 0.8rem;">
            If the service is not live, explore a past message or visit the YouTube channel.
            {social.channelUrl && <a href={social.channelUrl}> Open YouTube <span aria-hidden="true">↗</span></a>}
          </p>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="wrap measure">
          <p class="eyebrow">Keep exploring</p>
          <h2 class="block-title">There's more to discover.</h2>
          <p class="deck" style="margin-top: 1rem;">The livestream is not available yet. Explore our message library or find out about a first visit.</p>
          <div class="actions"><a class="btn" href={url('/sermons')}>Browse messages</a><a class="more" href={url('/visit')}>Plan a visit <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    )
  }
</Base>
