---
import Base from '../layouts/Base.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import NumberedList from '../components/NumberedList.astro';
import PageHeader from '../components/PageHeader.astro';
import Scripture from '../components/Scripture.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';

const story = [
  {
    title: 'God made you, and He loves you.',
    text: 'You are not an accident. God created you on purpose and for a purpose, and He wants to know you personally.',
    verse: { text: 'For God so loved the world that He gave His only begotten Son, that whoever believes in Him should not perish but have everlasting life.', reference: 'John 3:16' },
  },
  {
    title: 'Sin separates us from God.',
    text: 'Every one of us has gone our own way. The Bible calls that sin, and its result is separation from God. No amount of good works can close that gap.',
    verse: { text: 'For all have sinned and fall short of the glory of God.', reference: 'Romans 3:23' },
  },
  {
    title: 'Jesus paid the price.',
    text: 'Jesus, the Son of God, lived the sinless life we could not live. He died on the cross in our place and rose again on the third day, defeating sin and death.',
    verse: { text: 'For the wages of sin is death, but the gift of God is eternal life in Christ Jesus our Lord.', reference: 'Romans 6:23' },
  },
  {
    title: 'You can receive Him today.',
    text: 'Salvation is a gift. You receive it by turning from sin and trusting Jesus as your Savior and Lord. It is grace, not something you earn.',
    verse: { text: 'If you confess with your mouth the Lord Jesus and believe in your heart that God has raised Him from the dead, you will be saved.', reference: 'Romans 10:9' },
  },
];

const nextSteps = [
  { icon: 'message', title: 'Tell someone', text: 'Let us know. We want to celebrate with you, pray with you, and help you take your next steps.', href: '/contact', label: 'Tell a pastor' },
  { icon: 'heart', title: 'Get baptized', text: 'Water baptism is a public declaration that you belong to Jesus. Ask about our next baptism service.', href: '/next-steps#baptism', label: 'About baptism' },
  { icon: 'book', title: 'Read the Bible', text: 'Start with the Gospel of John. Read a chapter a day and ask God to speak to you.', href: '/sermons/the-woman-at-the-well', label: 'Start in John 4' },
  { icon: 'kids', title: 'Find your people', text: 'Faith grows best in community. Join us on Sunday and find a group to walk with.', href: '/ministries/groups', label: 'Find a group' },
] as const;
---

<Base title="Know Jesus" description="The good news of Jesus Christ: God loves you, Jesus paid the price for sin, and you can receive new life today.">
  <PageHeader eyebrow="The good news" title="Living water for a thirsty soul." lede="Our church is named for a conversation Jesus had at a well. He offered a thirsty woman living water. He offers the same to you." />

  <Section space="flush-top" labelledby="well-title">
    <div class="well" data-reveal>
      <Scripture text="Whoever drinks of the water that I shall give him will never thirst." reference="John 4:14" size="lg" />
      <div class="stack">
        <h2 id="well-title" class="sr-only">The woman at the well</h2>
        <p class="lede">In John 4, Jesus sat down by a well in Samaria and spoke with a woman everyone else avoided. He knew her whole story, and He still offered her life.</p>
        <p class="muted">That is still who Jesus is. Wherever you have been and whatever you carry, He knows you and He invites you to come. Here is the good news, simply put.</p>
      </div>
    </div>
  </Section>

  <Section labelledby="gospel-title">
    <h2 id="gospel-title" class="sr-only">The good news in four parts</h2>
    <NumberedList items={story} />
  </Section>

  <Section tone="navy" labelledby="prayer-title">
    <div class="prayer" data-reveal>
      <div class="stack">
        <p class="eyebrow">Pray with us</p>
        <h2 id="prayer-title">Ready to say yes?</h2>
        <p class="lede">There are no magic words. God looks at the heart. If you want to give your life to Jesus, you can pray something like this, right now, wherever you are.</p>
      </div>
      <blockquote class="prayer-card">
        <p>Jesus, I believe You are the Son of God. I believe You died on the cross for my sins and rose again. I confess that I have sinned, and I turn from it. Please forgive me. I receive You as my Savior and my Lord. Fill me with Your Holy Spirit and help me follow You every day. Thank You for new life. Amen.</p>
      </blockquote>
    </div>
  </Section>

  <Section labelledby="family-title">
    <SectionHeader id="family-title" align="split" eyebrow="I prayed that prayer" title="Welcome to the family." lede="If you just prayed and meant it, heaven is rejoicing (Luke 15:10), and so are we. Here is where to go from here." />
    <FeatureGrid items={nextSteps} columns={4} variant="cards" />
  </Section>
</Base>

<style>
  .well { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .prayer { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .prayer-card { margin: 0; padding: clamp(1.75rem, 3vw, 2.75rem); border: 1px solid var(--line-strong); border-radius: var(--radius-lg); background: var(--surface); }
  .prayer-card p { font: 500 clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem) / 1.6 var(--serif); color: var(--heading); }
  @media (max-width: 1000px) { .well, .prayer { grid-template-columns: 1fr; } }
</style>
