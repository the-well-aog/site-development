---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ContactOptions from '../components/ContactOptions.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ServiceTimes from '../components/ServiceTimes.astro';
import { site } from '../data/site';
---

<Base title="Contact" description={`Contact ${site.legal} in ${site.locality}, Oklahoma: address, phone, service times, and how to reach a pastor.`}>
  <PageHeader eyebrow="Contact" title="Start with hello." lede="A question about Sunday, a prayer need, or a conversation about faith. A real person from The Well will get back to you." />

  <Section space="flush-top" labelledby="reach-title">
    <div class="layout">
      <div class="info" data-reveal>
        <h2 id="reach-title" class="sr-only">Find us</h2>
        <div>
          <p class="label">Visit</p>
          <p class="big"><a href={site.mapsHref}>{site.address}<br />{site.city}</a></p>
          <div class="row">
            <Button href={site.mapsHref} variant="text">Google Maps</Button>
            <Button href={site.appleMapsHref} variant="text">Apple Maps</Button>
          </div>
        </div>
        <div>
          <p class="label">Call</p>
          <p class="big"><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
        </div>
        <div>
          <p class="label">Gather</p>
          <ServiceTimes />
        </div>
      </div>
      <ContactOptions title="Send us a note" text="Not an emergency line. If you are in danger, call 911, or call or text 988." subject="Website message" submit="Send message">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <label class="check"><input type="checkbox" name="prayer" />This is a prayer request</label>
      </ContactOptions>
    </div>
  </Section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .info { display: grid; gap: 2.25rem; }
  .label { margin-bottom: 0.5rem; font: 600 0.72rem / 1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-muted); }
  .big { font: 500 clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem) / 1.2 var(--serif); letter-spacing: -0.025em; color: var(--heading); }
  .big a { text-decoration: none; }
  .big a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .row { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  @media (max-width: 1000px) { .layout { grid-template-columns: 1fr; } }
</style>
