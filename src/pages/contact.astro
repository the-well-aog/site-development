---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderForm from '../components/PlaceholderForm.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<Base title="Contact" description="Find contact information and ways to connect with The Well Assembly of God." image="images/exterior.jpg">
  <PageHero kicker="Let’s connect" title="Start with hello." deck="A question about Sunday, a prayer need, or a conversation about faith. A real person from The Well will read your message." />
  <section class="section" style="padding-top: 0.4rem;">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Find The Well</p>
        <h2 class="block-title" style="font-size: clamp(2rem, 4vw, 2.6rem);"><a href={site.mapsHref}>{site.address}</a></h2>
        <p class="deck" style="margin-top: 0.4rem;">{site.city}</p>
        <p style="margin-top: 0.8rem;"><a class="more" href={site.phoneHref}>{site.phoneDisplay}</a></p>
        {site.preview && <p class="fine" style="margin-top: 1rem;">Service times are awaiting final confirmation.</p>}
        <dl class="facts contact-times">
          <div><dt>{site.sundayLabel}</dt><dd>{site.sundayTime}</dd></div>
          <div><dt>{site.midweekLabel}</dt><dd>{site.midweekTime}</dd></div>
        </dl>
        <div class="contact-paths">
          <a class="contact-path" href={url('/visit')}><span><strong>Planning a first visit?</strong><small>Start with what to expect.</small></span><span aria-hidden="true">↗</span></a>
          <a class="contact-path" href={url('/prayer')}><span><strong>Looking for prayer?</strong><small>Explore the prayer page.</small></span><span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="panel">
        <h2 class="card-title" style="margin: 0 0 1.3rem;">Send a note</h2>
        <PlaceholderForm submit="Send a note">
          <label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label class="field"><span>Message</span><textarea name="message" rows="5" required></textarea></label>
          <label class="check"><input type="checkbox" name="prayer" /><span>This is a prayer request</span></label>
          <p class="fine">This is not an emergency line. If you are in danger, call 911, or call or text 988.</p>
        </PlaceholderForm>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-times { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .contact-grid h2 a { text-decoration: none; }
  .contact-grid h2 a:hover { text-decoration: underline; text-underline-offset: .15em; }
  .contact-path { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 0; border-top: 1px solid var(--line); text-decoration: none; }
  .contact-path:last-child { border-bottom: 1px solid var(--line); }
  .contact-path strong, .contact-path small { display: block; }
  .contact-path strong { font-weight: 500; }
  .contact-path small { margin-top: .2rem; color: var(--muted); }
  .contact-path > span:last-child { font-size: 1.35rem; color: var(--tide); }
  .contact-path:hover strong { text-decoration: underline; text-underline-offset: .2em; }
</style>
