---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderForm from '../components/PlaceholderForm.astro';
import { lede } from '../data/copy';
import { site } from '../data/site';
---

<Base title="Contact" description="Write or call The Well Assembly of God." image="images/exterior.jpg">
  <PageHero kicker="Hello" title="Contact" deck={lede} />
  <section class="section" style="padding-top: 0.4rem;">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Office</p>
        <h2 class="block-title" style="font-size: 2.6rem;">{site.address}</h2>
        <p class="deck" style="margin-top: 0.4rem;">{site.city}</p>
        <p class="meta-row">
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <dl class="facts" style="grid-template-columns: 1fr 1fr;">
          <div>
            <dt>{site.sundayLabel}</dt>
            <dd>{site.sundayTime}</dd>
          </div>
          <div>
            <dt>{site.midweekLabel}</dt>
            <dd>{site.midweekTime}</dd>
          </div>
        </dl>
      </div>
      <div class="panel">
        <PlaceholderForm submit="Send a note">
          <label class="field">
            <span>Name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label class="field">
            <span>Message</span>
            <textarea name="message" required></textarea>
          </label>
          <label class="check">
            <input type="checkbox" name="prayer" />
            <span>This is a prayer request</span>
          </label>
        </PlaceholderForm>
      </div>
    </div>
  </section>
</Base>
