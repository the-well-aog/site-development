---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site, sunday } from '../data/site';
import { url } from '../lib/url';

const leaders = (await getCollection('leaders')).sort((a, b) => a.data.order - b.data.order);

const values = [
  { title: 'Jesus at the center', text: 'Everything we do points to Jesus Christ: His cross, His resurrection, and His invitation to new life.', ref: 'Colossians 1:18' },
  { title: 'Rooted in the Word', text: 'The Bible is God’s inspired Word. We preach it, read it, and build our lives on it.', ref: '2 Timothy 3:16' },
  { title: 'Empowered by the Spirit', text: 'We are Pentecostal. We welcome the presence and gifts of the Holy Spirit, decently and in order.', ref: 'Acts 1:8 · 1 Corinthians 14:40' },
  { title: 'Devoted to prayer', text: 'Prayer is not a program here. It is how we begin, how we decide, and how we care for one another.', ref: 'Acts 2:42' },
  { title: 'A family for every generation', text: 'From the nursery to the grandparents, the church is a family where every age belongs and grows.', ref: 'Psalm 145:4' },
  { title: 'Sent to our community', text: `We share the gospel and show the love of Jesus in ${site.locality}, the Fort Smith area, and to the ends of the earth.`, ref: 'Matthew 28:19–20' },
];

const hasPhotos = leaders.some((entry) => entry.data.photo);
const initials = (name: string) => name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
---

<Base title="About" description={`${site.legal} is a Spirit-filled, Bible-based church in ${site.locality}, Oklahoma, where every generation can meet Jesus, grow in faith, and belong.`}>
  <PageHeader eyebrow="Our story" title="A well in Pocola." lede={`The Well is a Pentecostal church family in the ${site.affiliation}, here to help people meet Jesus, be filled with His Spirit, and live out their faith together.`} />

  <Section width="wide" space="flush-top" labelledby="name-title">
    <div class="story" data-reveal>
      <figure class="story-verse">
        <svg class="story-rings" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
          {[40, 80, 120, 160, 200].map((r) => <circle cx="200" cy="200" r={r} />)}
        </svg>
        <blockquote>
          <p>“The water that I shall give him will become in him a fountain of water springing up into everlasting life.”</p>
        </blockquote>
        <figcaption><span class="ref">John 4:14</span> <span class="version">NKJV</span></figcaption>
      </figure>
      <div class="story-copy">
        <p class="eyebrow">Why “The Well”</p>
        <h2 id="name-title">Where thirsty people <em>meet Jesus.</em></h2>
        <div class="stack">
          <p class="lede">In John 4, Jesus met a woman at a well in the middle of an ordinary day. She came for water. She left with living water, and then she ran to tell her whole town.</p>
          <p class="muted">That is the heart of our church. We want The Well to be a place where anyone can come as they are and meet the Jesus who knows them completely and loves them anyway. And like that woman, we want everyone who drinks of that living water to carry it to someone else.</p>
          <p class="muted">We love God’s presence. Our worship is heartfelt, our preaching comes from the Bible, and our altars are open. We pray for the sick, we believe God still speaks and moves, and we make room for the Holy Spirit to do what only He can do.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="navy" labelledby="mission-title">
    <div class="mission" data-reveal>
      <p class="eyebrow" id="mission-title">Our mission</p>
      <p class="mission-line">To <em>reach</em> people with the good news of Jesus, <em>root</em> them in God’s Word, <em>fill</em> them with the Holy Spirit, and <em>send</em> them out to love and serve.</p>
    </div>
  </Section>

  <Section labelledby="values-title">
    <SectionHeader id="values-title" align="center" eyebrow="What we value" title="What shapes us." lede="Six convictions guide how we worship, how we decide, and how we treat one another." action={{ href: '/beliefs', label: 'Read what we believe' }} />
    <FeatureGrid items={values} columns={3} />
  </Section>

  <Section tone="sand" id="team" labelledby="team-title">
    <SectionHeader id="team-title" align="split" eyebrow="Our team" title="Shepherds who serve." lede="Our pastors and leaders are called to love God, preach His Word, and care for the people of The Well." />
    {site.preview && <p class="team-note">Names, photos, and biographies are coming soon.</p>}
    <ul class:list={['team', { 'team-compact': !hasPhotos }]} role="list" data-reveal>
      {leaders.map((entry) => (
        <li>
          {hasPhotos ? (
            <div class="team-photo">
              {entry.data.photo ? (
                <img src={url(entry.data.photo)} alt={entry.data.name} width="600" height="750" loading="lazy" />
              ) : (
                <span class="team-placeholder" aria-hidden="true"><span>{initials(entry.data.name)}</span></span>
              )}
            </div>
          ) : (
            <span class="team-initials" aria-hidden="true">{initials(entry.data.name)}</span>
          )}
          <h3>{entry.data.name}</h3>
          <p class="ref">{entry.data.role}</p>
          <p class="team-summary">{entry.data.summary}</p>
        </li>
      ))}
    </ul>
    <div class="team-contact">
      <p>Need a pastor for prayer, a hospital visit, a wedding, or a baby dedication?</p>
      <Button href="/contact" variant="text">Contact a pastor</Button>
    </div>
  </Section>

  <Section labelledby="family-title">
    <div class="family" data-reveal>
      <div>
        <p class="eyebrow">Our fellowship</p>
        <h2 id="family-title">Part of something bigger.</h2>
      </div>
      <div class="stack">
        <p class="lede">The Well is affiliated with the {site.affiliation}{site.district ? ` and the ${site.district}` : ''}, a worldwide Pentecostal fellowship of churches committed to evangelism, worship, discipleship, and compassion.</p>
        <Button href="https://ag.org" variant="text">Visit ag.org</Button>
      </div>
    </div>
  </Section>

  <CtaBand eyebrow="Come and see" title="There’s a seat" accent="saved for you." text={`The best way to know a church is to worship with it. Join us this ${sunday.day} at ${sunday.time}.`} primary={{ href: '/visit', label: 'Plan your visit' }} secondary={{ href: '/beliefs', label: 'What we believe' }} />
</Base>

<style>
  .story { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .story-verse { position: relative; display: grid; align-content: center; gap: 1.25rem; min-height: 26rem; margin: 0; overflow: hidden; padding: clamp(2rem, 5vw, 3.5rem); border-radius: var(--radius-lg); background: var(--sand); }
  .story-rings { position: absolute; width: 140%; left: -20%; top: 30%; fill: none; stroke: var(--navy); stroke-opacity: 0.08; pointer-events: none; }
  .story-verse blockquote { position: relative; margin: 0; }
  .story-verse blockquote p { font: italic 500 clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem) / 1.25 var(--serif); letter-spacing: -0.02em; color: var(--heading); text-wrap: balance; }
  .story-verse figcaption { position: relative; display: flex; gap: 0.6rem; align-items: baseline; }
  .story-verse .version { font: 600 0.68rem / 1.4 var(--sans); letter-spacing: 0.12em; color: var(--fg-muted); }
  .story-copy { display: grid; gap: 1.5rem; }

  .mission { display: grid; gap: 1.5rem; justify-items: center; max-width: 60rem; margin-inline: auto; text-align: center; }
  .mission-line { font: 500 clamp(1.8rem, 1.3rem + 2.2vw, 3.1rem) / 1.22 var(--serif); letter-spacing: -0.03em; color: var(--heading); text-wrap: balance; }
  .mission-line em { color: var(--accent-ink); }

  .team-note { margin: -1.5rem 0 2rem; color: var(--fg-muted); font-size: 0.9rem; }
  .team { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem 1.25rem; }
  .team li { display: grid; align-content: start; gap: 0.5rem; }
  .team-photo { overflow: hidden; aspect-ratio: 4 / 5; margin-bottom: 0.75rem; border-radius: var(--radius); background: var(--sand-2); }
  .team-photo img { width: 100%; height: 100%; object-fit: cover; }
  .team-placeholder { display: grid; place-items: center; width: 100%; height: 100%; background: radial-gradient(circle at 50% 35%, var(--paper), var(--sand-2) 70%); }
  .team-placeholder span { display: grid; place-items: center; width: 5.5rem; height: 5.5rem; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--paper); color: var(--navy); font: 500 1.8rem var(--serif); letter-spacing: 0.02em; box-shadow: var(--shadow-sm); }
  .team h3 { font-size: 1.4rem; }
  .team-summary { color: var(--fg-muted); font-size: 0.93rem; }
  .team-compact { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .team-compact li { padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
  .team-initials { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; margin-bottom: 0.75rem; border-radius: 50%; background: var(--navy); color: var(--paper); font: 500 1.1rem var(--serif); letter-spacing: 0.04em; }
  .team-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line-strong); }

  .family { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; }

  @media (max-width: 1000px) {
    .story, .family { grid-template-columns: 1fr; }
    .story-verse { min-height: 0; }
    .team { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) { .team, .team-compact { grid-template-columns: 1fr; } }
</style>
