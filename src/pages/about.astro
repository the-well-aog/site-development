---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { body, lede, more } from '../data/copy';
import { img, url } from '../lib/url';
---

<Base title="About" description="The story of The Well Assembly of God." image="images/chapel.jpg">
  <PageHero kicker="About" title="A people, a place." deck={lede} />
  <section class="section">
    <div class="wrap split">
      <div class="frame">
        <img src={img('chapel')} alt="Sunlight, linen, and a wooden chair in a quiet corner." />
      </div>
      <div class="measure">
        <p>{lede}</p>
        <p>{body}</p>
        <p>{more}</p>
        <div class="actions">
          <a class="btn" href={url('/beliefs')}>What we believe</a>
          <a class="more" href={url('/leadership')}>Leadership <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
  <section class="band-dark">
    <div class="wrap sermon-feature">
      <div>
        <p class="eyebrow light">Assemblies of God</p>
        <h2>Sixteen truths, one confession.</h2>
        <p class="deck" style="color: rgba(243,239,230,0.78); margin: 1rem 0 1.4rem;">{lede}</p>
        <a class="btn btn-light" href={url('/beliefs')}>Read the beliefs</a>
      </div>
      <div class="frame">
        <img src={img('water')} alt="A round stone basin of still water." />
      </div>
    </div>
  </section>
</Base>
