---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { isPlaceholderText } from '../../data/copy';
import { iso, longDate } from '../../lib/format';
import { img, url } from '../../lib/url';

export async function getStaticPaths() {
  const events = (await getCollection('events')).filter((entry) => site.preview || !entry.data.draft);
  return events.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'events'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const preview = entry.data.draft || isPlaceholderText(entry.data.summary) || isPlaceholderText(entry.body);
const summary = isPlaceholderText(entry.data.summary)
  ? 'A preview of an event at The Well. Full details will be added once they are confirmed.'
  : entry.data.summary;
---

<Base title={entry.data.title} description={summary} image={`images/${entry.data.image}.jpg`}>
  <header class="page-hero">
    <div class="wrap">
      <p class="fine" style="margin-bottom: 1.4rem;"><a href={url('/events')}>← All events</a></p>
      <p class="eyebrow">{entry.data.place}</p>
      <h1>{entry.data.title}</h1>
      <p class="deck">{summary}</p>
      {preview && <p class="fine" style="margin-top: 1rem;">Sample event for the website preview. The date and details are not confirmed.</p>}
    </div>
  </header>
  <section class="section" style="padding-top: 0;">
    <div class="wrap detail">
      <div>
        <div class="detail-hero">
          <img src={img(entry.data.image)} alt={entry.data.alt} loading="lazy" />
        </div>
        <div class="prose">
          {isPlaceholderText(entry.body) ? <><h2 class="card-title">More details to come.</h2><p style="margin-top: 1rem;">This event is sample content for the website preview. The church will confirm the description, gathering details, and any registration information before it is announced.</p></> : <Content />}
        </div>
        <p style="margin-top: 1.6rem;">
          <a class="more" href={url('/events')}>All events <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <aside>
        <dl>
          <div>
            <dt>Date</dt>
            <dd><time datetime={iso(entry.data.date)}>{longDate(entry.data.date)}</time></dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>{entry.data.time}</dd>
          </div>
          <div>
            <dt>Place</dt>
            <dd>{entry.data.place}</dd>
          </div>
        </dl>
        <a class="btn" href={url('/contact')}>Ask about this event</a>
      </aside>
    </div>
  </section>
</Base>
