---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { lede } from '../../data/copy';
import { img, url } from '../../lib/url';

const ministries = (await getCollection('ministries')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Ministries" description="Kids, students, and groups at The Well Assembly of God." image="images/table.jpg">
  <PageHero kicker="Ministries" title="Rooms in the house" deck={lede} />
  <section class="section" style="padding-top: 0.5rem;">
    <div class="wrap">
      {
        ministries.map((entry, index) => (
          <a class:list={['ministry-row', { flip: index % 2 === 1 }]} href={url(`/ministries/${entry.id}`)}>
            <img src={img(entry.data.image)} alt={entry.data.alt} />
            <div>
              <p class="eyebrow">{entry.data.who}</p>
              <h2 class="block-title">{entry.data.title}</h2>
              <p class="deck" style="margin-top: 0.8rem;">{entry.data.summary}</p>
              <p class="meta-row">{entry.data.when}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
