---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import MinistryCard from '../../components/MinistryCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { site } from '../../data/site';
import { ministries as listMinistries } from '../../lib/ministries';
import { photoFor } from '../../lib/url';

export async function getStaticPaths() {
  const ministries = await listMinistries();
  return ministries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'ministries'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const others = (await listMinistries()).filter((other) => other.id !== entry.id);
---

<Base title={entry.data.title} description={entry.data.summary} image={photoFor(entry.data)}>
  <PageHeader back={{ href: '/ministries', label: 'All ministries' }} eyebrow={entry.data.who} title={entry.data.title} lede={entry.data.summary} image={{ src: photoFor(entry.data), alt: entry.data.alt }} />

  <Section width="wide">
    <DetailLayout
      facts={[
        { icon: 'kids', label: 'Who', value: entry.data.who },
        { icon: 'clock', label: 'When', value: entry.data.when },
        { icon: 'pin', label: 'Where', value: site.legal, note: `${site.address}, ${site.locality}` },
      ]}
      note={site.preview ? 'Meeting times are awaiting final confirmation.' : undefined}
    >
      <div class="prose"><Content /></div>
      <Fragment slot="actions">
        <Button href="/visit">Plan your visit</Button>
        <Button href="/contact" variant="text">Ask a question</Button>
      </Fragment>
    </DetailLayout>
  </Section>

  {others.length > 0 && (
    <Section tone="sand" width="wide" labelledby="more-title">
      <SectionHeader id="more-title" eyebrow="Ministries" title="There’s more for your family." />
      <div class="others swipe-row">{others.map((other) => <MinistryCard entry={other} />)}</div>
    </Section>
  )}
</Base>

<style>
  .others { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 1000px) { .others { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .others { grid-template-columns: 1fr; } }
</style>
