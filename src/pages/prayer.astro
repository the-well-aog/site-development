---
import Base from '../layouts/Base.astro';
import ContactOptions from '../components/ContactOptions.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PageHeader from '../components/PageHeader.astro';
import StillToggle from '../components/StillToggle.astro';
import Scripture from '../components/Scripture.astro';
import Section from '../components/Section.astro';
import { prayerMeeting, site } from '../data/site';

const ways = [
  { icon: 'hands', title: 'At the altar', text: 'At the end of every service, pastors and our prayer team are at the front, ready to pray with you.' },
  { icon: 'flame', title: `${prayerMeeting.day} prayer meeting`, text: `Every ${prayerMeeting.day} at ${prayerMeeting.time} the church gathers to seek God together. Bring your need and pray with us.` },
  { icon: 'phone', title: 'With a pastor', text: 'Call for prayer, a hospital or home visit, or anointing for the sick. A pastor will come to you.' },
] as const;
---

<Base still title="Prayer" description={`Share a prayer request with ${site.legal}. Our pastors and prayer team would be honored to pray with you.`}>
  <PageHeader eyebrow="Prayer" title="You don’t have to" accent="carry it alone." lede="A burden, a need for healing, a hope, or a reason to give thanks. You don’t need the perfect words. God is listening.">
    <Fragment slot="actions"><StillToggle /></Fragment>
  </PageHeader>

  <Section space="flush-top" labelledby="request-title">
    <div class="layout">
      <div class="stack copy" data-reveal>
        <Scripture text="Is any sick among you? let him call for the elders of the church; and let them pray over him, anointing him with oil in the name of the Lord." reference="James 5:14" />
        <p class="muted">We believe God hears and answers prayer. We believe Jesus still heals, saves, restores, and provides. Whatever you are facing, sickness, grief, addiction, a broken relationship, a hard decision, or a reason to give thanks, we would be honored to pray with you.</p>
        <p class="crisis">If you are in danger or thinking about harming yourself, call 911, or call or text 988 (Suicide &amp; Crisis Lifeline) now. Prayer requests are not monitored around the clock.</p>
      </div>
      <ContactOptions title="Share a prayer request" text="Requests are read by our pastors and prayer team and kept confidential." subject="Prayer request" submit="Send my request">
        <label>Name (optional)<input name="name" autocomplete="name" /></label>
        <label>Email (optional)<input name="email" type="email" autocomplete="email" /></label>
        <label>How can we pray for you?<textarea name="request" rows="5" required></textarea></label>
        <label class="check"><input type="checkbox" name="contact" />I’d like a pastor to contact me</label>
      </ContactOptions>
    </div>
  </Section>

  <Section tone="sand" labelledby="ways-title">
    <h2 id="ways-title" class="ways-title">Other ways to pray with us</h2>
    <FeatureGrid items={ways} columns={3} />
  </Section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .copy { --stack: 1.5rem; }
  .crisis { padding: 1rem 1.15rem; border-left: 3px solid var(--gold); border-radius: 0 var(--radius) var(--radius) 0; background: var(--sand); color: var(--fg); font-size: 0.92rem; }
  .ways-title { margin-bottom: 2rem; font-size: clamp(1.75rem, 1.5rem + 1vw, 2.4rem); }
  @media (max-width: 1000px) { .layout { grid-template-columns: 1fr; } }
</style>
