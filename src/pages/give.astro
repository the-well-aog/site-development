---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Scripture from '../components/Scripture.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { midweek, site, sunday } from '../data/site';

// The church's giving provider (Tithe.ly, Pushpay, Planning Center…). Blank shows in-person and mail options only.
const givingUrl = '';

const impact = [
  { icon: 'heart', title: 'Reaching our community', text: `Outreach events, serving families in need, and sharing the gospel across ${site.locality} and the Fort Smith area.` },
  { icon: 'kids', title: 'Raising the next generation', text: 'Kids and students ministry: curriculum, safe spaces, camps, and leaders who invest in young lives.' },
  { icon: 'flame', title: 'Sending missionaries', text: `Supporting ${site.affiliation} missionaries who carry the gospel across the nation and around the world.` },
  { icon: 'door', title: 'Caring for the church', text: 'Pastoral care, worship, the building, and everything it takes to open the doors each week.' },
] as const;
---

<Base title="Give" description={`Give to ${site.legal}. Your tithes and offerings help reach ${site.locality} with the gospel, raise the next generation, and send missionaries around the world.`}>
  <PageHeader eyebrow="Give" title="Give with joy." lede="Giving is worship. It is a response to a generous God who gave His Son for us, and a way to be part of what He is doing through The Well." />

  <Section space="flush-top" labelledby="ways-title">
    <h2 id="ways-title" class="sr-only">Ways to give</h2>
    <div class:list={['ways', { 'ways-online': givingUrl }]} data-reveal>
      {givingUrl && (
        <article class="way way-online">
          <span class="way-icon"><Icon name="heart" size={22} /></span>
          <h3>Give online</h3>
          <p>Give once or set up recurring giving through our secure giving partner.</p>
          <Button href={givingUrl} size="lg">Give online</Button>
          <p class="way-note">This website never collects card or bank details.</p>
        </article>
      )}
      <article class="way">
        <span class="way-icon"><Icon name="hands" size={22} /></span>
        <h3>During a service</h3>
        <p>Place your gift in the offering during worship on {sunday.day}s at {sunday.time} or {midweek.day}s at {midweek.time}.</p>
      </article>
      <article class="way">
        <span class="way-icon"><Icon name="mail" size={22} /></span>
        <h3>By mail</h3>
        <p>Make checks payable to <strong>{site.legal}</strong> and mail them to:</p>
        <address>{site.address}<br />{site.city}</address>
      </article>
    </div>
    {!givingUrl && (
      <p class="online-soon"><Icon name="heart" size={18} />Online giving is coming soon. This website never collects card or bank details.</p>
    )}
  </Section>

  <Section tone="navy" labelledby="why-title">
    <div class="why" data-reveal>
      <div class="stack">
        <p class="eyebrow">Why we give</p>
        <h2 id="why-title">Because God gave first.</h2>
      </div>
      <div class="stack">
        <Scripture text="So let each one give as he purposes in his heart, not grudgingly or of necessity; for God loves a cheerful giver." reference="2 Corinthians 9:7" />
        <p class="muted">Everything we have comes from God. When we bring our tithes and offerings, we are not paying God or buying His favor; we already have it in Christ. We are saying thank you, putting Him first, and trusting Him with our lives.</p>
        <p class="muted">The Bible teaches the tithe, the first tenth, as a starting place for faithful giving (Malachi 3:10), and calls every believer to be generous with an open hand. Give with joy, as God leads you.</p>
      </div>
    </div>
  </Section>

  <Section labelledby="impact-title">
    <SectionHeader id="impact-title" align="center" eyebrow="Your gift at work" title="Where your giving goes." lede="We handle every gift with integrity and accountability. If you have a question about how The Well stewards its finances, please ask." action={{ href: '/contact', label: 'Questions about giving' }} />
    <FeatureGrid items={impact} columns={4} />
  </Section>
</Base>

<style>
  .ways { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ways-online { grid-template-columns: 1.3fr 1fr 1fr; }
  .online-soon { display: flex; align-items: center; gap: 0.6rem; margin-top: 1.25rem; color: var(--fg-muted); font-size: 0.92rem; }
  .online-soon :global(.icon) { color: var(--accent-ink); flex: none; }
  .way { display: grid; align-content: start; justify-items: start; gap: 0.9rem; padding: clamp(1.5rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); }
  .way-online { background: var(--sand); }
  .way h3 { font-size: 1.6rem; }
  .way p { color: var(--fg-muted); }
  .way strong { color: var(--fg); font-weight: 500; }
  .way address { font: normal 500 1.15rem / 1.4 var(--serif); color: var(--heading); }
  .way-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--navy); color: #fff; }
  .way-note { font-size: 0.82rem; }
  .why { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (max-width: 1000px) { .ways, .why { grid-template-columns: 1fr; } }
</style>
