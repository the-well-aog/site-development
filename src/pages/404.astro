---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Page not found" description="Find your way back to The Well Assembly of God.">
  <PageHeader eyebrow="404 · Page not found" title="A little off the path." lede="This page may have moved, or the link may be incomplete. The good news: you are never too lost to be found (Luke 19:10).">
    <Fragment slot="actions">
      <Button href="/" size="lg">Back to home</Button>
      <Button href="/visit" variant="text">Plan a visit</Button>
      <Button href="/watch" variant="text">Watch a message</Button>
    </Fragment>
  </PageHeader>
</Base>
