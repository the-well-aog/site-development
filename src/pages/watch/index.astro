---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import MessageCard from '../../components/MessageCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { online, site, sunday } from '../../data/site';
import { loadSocial } from '../../lib/feeds';
import { longDate } from '../../lib/format';

// Each part of this page follows its own switch in site.features.
const social = await loadSocial();
const videos = site.features.youtube ? social.videos : [];
const [latest, ...older] = videos;
const liveUrl = site.features.livestream && social.channelUrl ? `${social.channelUrl}/live` : null;
---

<Base title="Watch" description={online ? `Worship with ${site.legal} online, live on ${sunday.day}s at ${sunday.time}, and catch up on recent messages.` : `Online worship from ${site.legal} is coming soon. Join us in person on ${sunday.day}s at ${sunday.time}.`} image={latest?.thumbnail}>
  {online ? (
    <PageHeader eyebrow="Watch" title="Worship with us," accent="wherever you are." lede={`Join the service live every ${sunday.day} at ${sunday.time}, or catch up on a recent message any time.`} />
  ) : (
    <PageHeader align="center" eyebrow="Watch" title="Come worship" accent="with us in person." lede={`We are getting online worship ready. Until then, there is a seat saved for you every ${sunday.day} at ${sunday.time}.`}>
      <Fragment slot="actions">
        <Button href="/visit" size="lg">Plan your visit</Button>
        {social.facebookPage && <Button href={social.facebookPage} variant="text">Follow along on Facebook</Button>}
      </Fragment>
    </PageHeader>
  )}

  {site.features.livestream && (
    <Section space="flush-top" width="wide" labelledby="live-title">
      <div class="live tone-navy" data-reveal>
        <svg class="live-rings" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
          {[50, 100, 150, 200].map((r) => <circle cx="200" cy="200" r={r} />)}
        </svg>
        <span class="live-badge"><Icon name="play" size={28} /></span>
        <div class="live-copy">
          <p class="ref">Every {sunday.day} · {sunday.time}</p>
          <h2 id="live-title">Worship live with us.</h2>
          <p class="muted">The service streams each week. Join from home, then come and see us in person when you can.</p>
        </div>
        <div class="live-actions">
          {liveUrl && <Button href={liveUrl} leading="play" icon="none">Watch live</Button>}
          {social.facebookPage && <Button href={social.facebookPage} variant="secondary" leading="facebook" icon="none">Follow on Facebook</Button>}
        </div>
      </div>
    </Section>
  )}

  {latest && (
    <Section space={site.features.livestream ? 'normal' : 'flush-top'} width="wide" labelledby="latest-title">
      <div class="latest" data-reveal>
        <VideoEmbed id={latest.id} title={latest.title} />
        <div class="latest-copy">
          <p class="ref">Latest message · {longDate(new Date(latest.published))}</p>
          <h2 id="latest-title">{latest.title}</h2>
          {latest.excerpt && <p class="muted">{latest.excerpt}</p>}
          <Button href={`/watch/${latest.id}`} variant="text">Open message page</Button>
        </div>
      </div>
    </Section>
  )}

  {older.length > 0 && (
    <Section width="wide" labelledby="recent-title">
      <SectionHeader id="recent-title" align="split" eyebrow="Recent messages" title="Catch up." action={social.channelUrl ? { href: social.channelUrl, label: 'YouTube channel' } : undefined} />
      <ul class="grid" role="list" data-reveal>
        {older.map((video) => (
          <li><MessageCard href={`/watch/${video.id}`} image={video.thumbnail} title={video.title} meta={longDate(new Date(video.published))} video /></li>
        ))}
      </ul>
    </Section>
  )}
</Base>

<style>
  .live { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1.5rem clamp(1.5rem, 4vw, 3rem); overflow: hidden; padding: clamp(1.75rem, 4vw, 3rem); border-radius: var(--radius-lg); background: var(--bg); color: var(--fg); }
  .live-rings { position: absolute; width: 34rem; left: -8rem; top: 50%; transform: translateY(-50%); fill: none; stroke: #fff; stroke-opacity: 0.08; pointer-events: none; }
  .live-badge { position: relative; display: grid; place-items: center; width: 5.5rem; height: 5.5rem; padding-left: 4px; border-radius: 50%; background: var(--paper); color: var(--navy); box-shadow: 0 0 0 10px rgb(255 255 255 / 8%); }
  .live-copy { position: relative; display: grid; gap: 0.5rem; }
  .live-copy h2 { font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.75rem); }
  .live-actions { position: relative; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .latest { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .latest-copy { display: grid; gap: 1rem; justify-items: start; }
  .latest-copy h2 { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.6rem); overflow-wrap: anywhere; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.25rem; }
  @media (max-width: 1000px) {
    .live { grid-template-columns: auto minmax(0, 1fr); }
    .live-actions { grid-column: 1 / -1; }
    .latest { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .live { grid-template-columns: 1fr; } .live-badge { width: 4.25rem; height: 4.25rem; } }
</style>
