---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import MessageCard from '../../components/MessageCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { site, sunday } from '../../data/site';
import { loadSocial } from '../../lib/feeds';
import { longDate } from '../../lib/format';
import { img } from '../../lib/url';

const social = await loadSocial();
const [latest, ...older] = social.videos;
const liveUrl = social.channelUrl ? `${social.channelUrl}/live` : null;
const sermons = (await getCollection('sermons')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const series = [...new Set(sermons.map((entry) => entry.data.series))];
---

<Base title="Watch" description={`Watch ${site.legal} live on ${sunday.day}s at ${sunday.time}, catch up on recent messages, and read sermon notes.`} image={latest?.thumbnail}>
  <PageHeader eyebrow="Watch" title="Worship with us," accent="wherever you are." lede={`Join the service live every ${sunday.day} at ${sunday.time}, or catch up on a recent message any time.`}>
    <Fragment slot="actions">
      {liveUrl && <Button href={liveUrl} leading="play" icon="none" size="lg">Watch live on YouTube</Button>}
      <span class="live-when"><Icon name="clock" size={18} />Live {sunday.day}s at {sunday.time}</span>
    </Fragment>
  </PageHeader>

  {latest && (
    <Section space="flush-top" width="wide" labelledby="latest-title">
      <div class="latest" data-reveal>
        <VideoEmbed id={latest.id} title={latest.title} />
        <div class="latest-copy">
          <p class="ref">Latest message · {longDate(new Date(latest.published))}</p>
          <h2 id="latest-title">{latest.title}</h2>
          {latest.excerpt && <p class="muted">{latest.excerpt}</p>}
          <Button href={`/watch/${latest.id}`} variant="text">Open message page</Button>
        </div>
      </div>
    </Section>
  )}

  {older.length > 0 && (
    <Section width="wide" labelledby="recent-title">
      <SectionHeader id="recent-title" align="split" eyebrow="Recent messages" title="Catch up." action={social.channelUrl ? { href: social.channelUrl, label: 'YouTube channel' } : undefined} />
      <ul class="grid" role="list" data-reveal>
        {older.map((video) => (
          <li><MessageCard href={`/watch/${video.id}`} image={video.thumbnail} title={video.title} meta={longDate(new Date(video.published))} video /></li>
        ))}
      </ul>
    </Section>
  )}

  {sermons.length > 0 && (
    <Section tone="sand" width="wide" labelledby="notes-title">
      <SectionHeader id="notes-title" align="split" eyebrow={series.length === 1 ? `Series · ${series[0]}` : 'Sermon notes'} title="Read and reflect." lede="Outlines and discussion questions to take a message deeper, on your own or with your group." />
      <ul class="grid" role="list" data-reveal>
        {sermons.map((entry) => (
          <li><MessageCard href={`/sermons/${entry.id}`} image={img(entry.data.image)} alt={entry.data.alt} eyebrow={entry.data.passage} title={entry.data.title} summary={entry.data.summary} meta={`${longDate(entry.data.date)} · ${entry.data.speaker}`} video={Boolean(entry.data.video)} /></li>
        ))}
      </ul>
    </Section>
  )}

  {!latest && sermons.length === 0 && (
    <Section space="flush-top">
      <p class="lede">Messages will appear here soon. In the meantime, we would love to see you in person.</p>
      <Button href="/visit">Plan your visit</Button>
    </Section>
  )}
</Base>

<style>
  .live-when { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--fg-muted); font-size: 0.95rem; }
  .live-when :global(.icon) { color: var(--accent-ink); }
  .latest { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .latest-copy { display: grid; gap: 1rem; justify-items: start; }
  .latest-copy h2 { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.6rem); overflow-wrap: anywhere; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.25rem; }
  @media (max-width: 1000px) {
    .latest { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } }
</style>
