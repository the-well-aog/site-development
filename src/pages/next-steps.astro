---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import NumberedList from '../components/NumberedList.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { url } from '../lib/url';

const steps = [
  {
    id: 'jesus', title: 'Follow Jesus',
    text: 'Every step starts here. Following Jesus means turning from sin, trusting Him as Savior, and making Him Lord of your life. If you are not sure where you stand with God, we would love to help.',
    ref: 'John 14:6', link: { href: '/jesus', label: 'Read the good news' },
  },
  {
    id: 'baptism', title: 'Be baptized in water',
    text: 'Jesus commanded His followers to be baptized. Water baptism by immersion does not save you; it declares what Jesus has already done in you. You are buried with Him and raised to walk in new life. We hold baptism services through the year, and a pastor will meet with you first to talk it through.',
    ref: 'Matthew 28:19 · Romans 6:4', link: { href: '/contact', label: 'Ask about baptism' },
  },
  {
    id: 'holy-spirit', title: 'Receive the baptism in the Holy Spirit',
    text: 'On the Day of Pentecost the disciples were filled with the Holy Spirit and spoke in other tongues as the Spirit gave them utterance. That promise is for every believer today, and it brings power to live for Jesus and tell others about Him. We pray with believers to receive this gift at the altar on Sundays and Wednesdays.',
    ref: 'Acts 1:8 · Acts 2:4, 38–39', link: { href: '/beliefs#truth-07', label: 'What the Bible teaches' },
  },
  {
    id: 'groups', title: 'Grow in a group',
    text: 'Sunday is where we gather; groups are where we grow. Open the Bible together, pray for one another, and build friendships that carry you through the week.',
    ref: 'Acts 2:42', link: { href: '/ministries/groups', label: 'Find a group' },
  },
  {
    id: 'membership', title: 'Make The Well your home',
    text: 'Membership is how we say, “This is my church family.” Our membership class covers our story, our beliefs, and how you can be part of what God is doing here.',
    ref: 'Ephesians 2:19', link: { href: '/contact', label: 'Ask about the next class' },
  },
  {
    id: 'serve', title: 'Serve with your gifts',
    text: 'God has given every believer gifts to build up the church. Greeting, worship, kids, students, media, hospitality, prayer, outreach: there is a place for you to make a difference.',
    ref: '1 Peter 4:10', link: { href: '/contact', label: 'Join a team' },
  },
];
---

<Base title="Next steps" description="Follow Jesus, be baptized in water, receive the baptism in the Holy Spirit, join a group, become a member, and serve at The Well.">
  <PageHeader eyebrow="Grow" title="Your next step." lede="Following Jesus is a journey, not a single moment. Wherever you are today, here is a clear next step to take with us.">
    <nav slot="actions" class="jump" aria-label="Steps on this page">
      {steps.map((step, index) => <a href={url(`#${step.id}`)}><span>{String(index + 1).padStart(2, '0')}</span>{step.title}</a>)}
    </nav>
  </PageHeader>

  <Section space="flush-top" labelledby="steps-title">
    <h2 id="steps-title" class="sr-only">Six next steps</h2>
    <NumberedList items={steps} as="h3" />
  </Section>

  <CtaBand eyebrow="Your first step can be Sunday" title="Come and worship" accent="with us." text="See what to expect, find the service times, and bring your questions. We saved you a seat." primary={{ href: '/visit', label: 'Plan your visit' }} secondary={{ href: '/prayer', label: 'Ask for prayer' }} />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .jump a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; padding: 0 1rem 0 0.4rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.88rem; font-weight: 500; color: var(--heading); text-decoration: none; transition: background-color 0.2s var(--ease), color 0.2s var(--ease); }
  .jump a span { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--sand); font: italic 500 0.8rem var(--serif); color: var(--accent-ink); }
  .jump a:hover { background: var(--navy); border-color: var(--navy); color: #fff; }
</style>
