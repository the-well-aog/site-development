---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderForm from '../components/PlaceholderForm.astro';
import { lede } from '../data/copy';
import { url } from '../lib/url';

const steps = [
  { n: '01', title: 'Talk with us', href: '/contact', text: lede },
  { n: '02', title: 'Baptism', href: '/contact', text: lede },
  { n: '03', title: 'Join a group', href: '/ministries/groups', text: lede },
  { n: '04', title: 'Serve', href: '/contact', text: lede },
];
---

<Base title="Next steps" description="A path from a first visit into the life of The Well." image="images/table.jpg">
  <PageHero kicker="Next" title="Take a step." deck={lede} />
  <section class="section" style="padding-top: 0.4rem;">
    <div class="wrap">
      <div class="steps">
        {
          steps.map((step) => (
            <article class="step">
              <span class="num">{step.n}</span>
              <div>
                <h2>{step.title}</h2>
                <p>{step.text}</p>
                <p style="margin-top: 0.7rem;">
                  <a class="more" href={url(step.href)}>Begin <span aria-hidden="true">→</span></a>
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="wrap" style="max-width: 40rem;">
      <div class="panel">
        <p class="eyebrow">Serve</p>
        <h2 class="block-title" style="font-size: 2.3rem; margin-bottom: 1rem;">Lend a hand.</h2>
        <PlaceholderForm submit="Count me in">
          <label class="field">
            <span>Name</span>
            <input name="name" required />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" required />
          </label>
          <label class="field">
            <span>Where you might help</span>
            <textarea name="help"></textarea>
          </label>
        </PlaceholderForm>
      </div>
    </div>
  </section>
</Base>
