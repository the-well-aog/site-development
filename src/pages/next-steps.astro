---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import NumberedList from '../components/NumberedList.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Respond from '../components/Respond.astro';
import Section from '../components/Section.astro';
import { url } from '../lib/url';

const steps = [
  {
    id: 'jesus', title: 'Follow Jesus',
    text: 'Every step starts here. Following Jesus means turning from sin, trusting Him as Savior, and making Him Lord of your life. If you are not sure where you stand with God, we would love to help.',
    ref: 'John 14:6', link: { href: '/jesus', label: 'Read the good news' },
  },
  {
    id: 'baptism', title: 'Be baptized in water',
    text: 'Jesus commanded His followers to be baptized. Water baptism by immersion does not save you; it declares what Jesus has already done in you. You are buried with Him and raised to walk in new life. We hold baptism services through the year, and a pastor will meet with you first to talk it through.',
    ref: 'Matthew 28:19 · Romans 6:4', link: { href: '/contact', label: 'Ask about baptism' },
  },
  {
    id: 'holy-spirit', title: 'Receive the baptism in the Holy Spirit',
    text: 'On the Day of Pentecost the disciples were filled with the Holy Spirit and spoke in other tongues as the Spirit gave them utterance. That promise is for every believer today, and it brings power to live for Jesus and tell others about Him. We pray with believers to receive this gift at the altar on Sundays and Wednesdays.',
    ref: 'Acts 1:8 · Acts 2:4, 38–39', link: { href: '/beliefs#truth-07', label: 'What the Bible teaches' },
  },
  {
    id: 'groups', title: 'Grow in a group',
    text: 'Sunday is where we gather; groups are where we grow. Open the Bible together, pray for one another, and build friendships that carry you through the week.',
    ref: 'Acts 2:42', link: { href: '/ministries/groups', label: 'Find a group' },
  },
  {
    id: 'membership', title: 'Make The Well your home',
    text: 'Membership is how we say, “This is my church family.” Our membership class covers our story, our beliefs, and how you can be part of what God is doing here.',
    ref: 'Ephesians 2:19', link: { href: '/contact', label: 'Ask about the next class' },
  },
  {
    id: 'serve', title: 'Serve with your gifts',
    text: 'God has given every believer gifts to build up the church. Greeting, worship, kids, students, media, hospitality, prayer, outreach: there is a place for you to make a difference.',
    ref: '1 Peter 4:10', link: { href: '/contact', label: 'Join a team' },
  },
];
---

<Base title="Next steps" description="Follow Jesus, be baptized in water, receive the baptism in the Holy Spirit, join a group, become a member, and serve at The Well.">
  <PageHeader eyebrow="Grow" title="Your next step." lede="Following Jesus is a journey, not a single moment. Wherever you are today, here is a clear next step to take with us.">
    <nav slot="actions" class="path" aria-label="Steps on this page">
      <svg class="path-stream" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 30 C 80 6, 160 54, 250 30 S 420 6, 500 30 S 670 54, 750 30 S 920 6, 1000 30" />
      </svg>
      <ol role="list">
        {steps.map((step, index) => (
          <li>
            <a href={url(`#${step.id}`)} data-stone={step.id}>
              <span class="stone"><span class="stone-num">{String(index + 1).padStart(2, '0')}</span><Icon name="check" size={16} class="stone-check" /></span>
              <span class="stone-label">{step.title}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="path-note" data-path-note>Mark each step as you take it. Your progress stays on this device.</p>
    </nav>
  </PageHeader>

  <Section space="flush-top" labelledby="steps-title">
    <h2 id="steps-title" class="sr-only">Six next steps</h2>
    <NumberedList items={steps} as="h3" track />
  </Section>

  <Respond />

  <CtaBand eyebrow="Your first step can be Sunday" title="Come and worship" accent="with us." text="See what to expect, find the service times, and bring your questions. We saved you a seat." primary={{ href: '/visit', label: 'Plan your visit' }} secondary={{ href: '/prayer', label: 'Ask for prayer' }} />
</Base>

<style>
  /* Six stones across a stream: the steps of following Jesus, marked off as you take them. */
  .path { position: relative; width: 100%; margin-top: 0.5rem; }
  .path-stream { position: absolute; left: 0; right: 0; top: 1.05rem; width: 100%; height: 2.5rem; fill: none; stroke: var(--mist); stroke-width: 2; stroke-dasharray: 2 7; stroke-linecap: round; }
  .path ol { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; }
  .path a { display: grid; justify-items: center; gap: 0.6rem; color: var(--heading); text-align: center; text-decoration: none; }
  .stone { position: relative; display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border: 1px solid var(--line-strong); border-radius: 46% 54% 50% 50% / 55% 48% 52% 45%; background: var(--paper); box-shadow: var(--shadow-sm); transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.3s var(--ease); }
  .path li:nth-child(even) .stone { border-radius: 54% 46% 48% 52% / 46% 55% 45% 54%; }
  .stone-num { font: italic 500 1.1rem var(--serif); color: var(--accent-ink); }
  .path :global(.stone-check) { display: none; color: #fff; }
  .path a:hover .stone { transform: translateY(-3px); border-color: var(--heading); }
  .path a.is-done .stone { border-color: var(--gold); background: var(--gold); }
  .path a.is-done .stone-num { display: none; }
  .path a.is-done :global(.stone-check) { display: block; }
  .stone-label { font-size: 0.85rem; font-weight: 500; line-height: 1.3; }
  .path-note { margin-top: 1.25rem; color: var(--fg-muted); font-size: 0.88rem; }
  @media (max-width: 900px) {
    .path-stream { display: none; }
    .path ol { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.25rem; }
  }
</style>

<script>
  // Progress is a per-visitor convenience: kept in this browser only, and the page works without it.
  const KEY = 'thewell:next-steps';
  const read = (): string[] => {
    try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
  };
  const write = (done: string[]) => {
    try { localStorage.setItem(KEY, JSON.stringify(done)); } catch { /* storage unavailable */ }
  };
  const paint = (done: string[]) => {
    document.querySelectorAll<HTMLElement>('[data-step-toggle]').forEach((toggle) => toggle.setAttribute('aria-pressed', String(done.includes(toggle.dataset.stepToggle!))));
    document.querySelectorAll<HTMLElement>('[data-stone]').forEach((stone) => {
      const isDone = done.includes(stone.dataset.stone!);
      stone.classList.toggle('is-done', isDone);
      stone.setAttribute('aria-label', `${stone.textContent?.replace(/^\d+/, '').trim()}${isDone ? ' (taken)' : ''}`);
    });
  };
  document.querySelectorAll<HTMLElement>('[data-step-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const id = toggle.dataset.stepToggle!;
      const done = read();
      const next = done.includes(id) ? done.filter((step) => step !== id) : [...done, id];
      write(next);
      paint(next);
    });
  });
  paint(read());
</script>
