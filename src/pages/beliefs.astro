---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { beliefs, beliefsUrl } from '../data/beliefs';
---

<Base title="Beliefs" description="The sixteen Fundamental Truths of the Assemblies of God." image="images/water.jpg">
  <PageHero kicker="Our foundation" title="What we believe." deck="Explore the sixteen Fundamental Truths of the Assemblies of God, with the full statement available in its own words." />
  <section class="section" style="padding-top: 1rem;">
    <div class="wrap beliefs-layout">
      <aside>
        <p class="eyebrow">Statement</p>
        <p class="fine">
          These are the titles of the sixteen Fundamental Truths. Read the complete statement, including its Scripture references, on the Assemblies of God website.
        </p>
        <p style="margin-top: 1rem;">
          <a class="more" href={beliefsUrl}>Read the full statement <span aria-hidden="true">↗</span></a>
        </p>
      </aside>
      <div>
        {
          beliefs.map((item) => (
            <article class="truth">
              <span class="num">{item.n}</span>
              <div>
                <h2>{item.title}</h2>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
