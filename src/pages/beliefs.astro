---
import Base from '../layouts/Base.astro';
import Accordion from '../components/Accordion.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { beliefs, beliefsUrl, cardinal } from '../data/beliefs';
import { site } from '../data/site';

const truths = beliefs.map((item) => ({ id: `truth-${item.n}`, number: item.n, title: item.title, text: item.summary, ref: item.refs }));
const convictions = cardinal.map((item) => ({ title: item.title, text: item.text, ref: item.ref }));
---

<Base title="What we believe" description={`What ${site.legal} believes: Jesus Christ, the authority of Scripture, the baptism in the Holy Spirit, and the sixteen Fundamental Truths of the ${site.affiliation}.`}>
  <PageHeader eyebrow="What we believe" title="Jesus at the center." accent="The Spirit at work." lede={`We are a Pentecostal church in the ${site.affiliation}. Our faith rests on Jesus Christ, the authority of the Bible, and the power of the Holy Spirit.`} />

  <Section space="flush-top" labelledby="plain-title">
    <div class="plain" data-reveal>
      <h2 id="plain-title" class="sr-only">In plain words</h2>
      <p class="plain-lead">We believe the Bible is God’s inspired Word. We believe in one God, eternally existing as Father, Son, and Holy Spirit. We believe Jesus Christ is the Son of God, that He died for our sins and rose again, and that anyone who turns to Him in faith is forgiven and made new.</p>
      <div class="stack muted">
        <p>As a Pentecostal church, we also believe that the same Holy Spirit who filled the first disciples on the Day of Pentecost still fills believers today, with power to live for Jesus and to tell others about Him. We pray for the sick, we expect God to move, and we look forward to the return of Christ.</p>
        <p>The Well is affiliated with the {site.affiliation}{site.district ? ` and the ${site.district}` : ''}, and we hold to its Statement of Fundamental Truths, summarized below.</p>
      </div>
    </div>
  </Section>

  <Section tone="navy" labelledby="core-title">
    <SectionHeader id="core-title" eyebrow="Four core convictions" title="Jesus saves, heals, fills," accent="and is coming again." />
    <FeatureGrid items={convictions} columns={4} numbered />
  </Section>

  <Section labelledby="truths-title">
    <div class="truths">
      <aside class="truths-aside">
        <p class="eyebrow">Statement of faith</p>
        <h2 id="truths-title">The 16 Fundamental Truths</h2>
        <p class="muted small">Each truth in plain language, with its main Scripture references. The official statement is on the {site.affiliation} website.</p>
        <nav class="truths-index" aria-label="Jump to a truth">
          {truths.map((truth) => <a href={`#${truth.id}`} title={truth.title}>{truth.number}</a>)}
        </nav>
        <div class="truths-links">
          <Button href={beliefsUrl} variant="text">Official statement</Button>
          <Button href="https://ag.org/Beliefs/Position-Papers" variant="text">Position papers</Button>
        </div>
      </aside>
      <Accordion items={truths} />
    </div>
  </Section>

  <CtaBand eyebrow="Have questions?" title="Let’s open" accent="the Bible together." text="Questions about faith are welcome here. A pastor would be glad to sit down with you and talk it through, or start with the good news of Jesus." primary={{ href: '/jesus', label: 'Begin with Jesus' }} secondary={{ href: '/contact', label: 'Talk with a pastor' }} />
</Base>

<style>
  .plain { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .plain-lead { font: 500 clamp(1.35rem, 1.15rem + 0.9vw, 1.85rem) / 1.45 var(--serif); letter-spacing: -0.015em; color: var(--heading); }

  .truths { display: grid; grid-template-columns: 19rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .truths-aside { position: sticky; top: calc(var(--header-h) + 2rem); display: grid; gap: 1rem; }
  .truths-aside h2 { font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem); }
  .truths-index { display: grid; grid-template-columns: repeat(8, 1fr); gap: 0.35rem; margin-top: 0.5rem; }
  .truths-index a { display: grid; place-items: center; aspect-ratio: 1; border: 1px solid var(--line); border-radius: 8px; font: 500 0.78rem var(--sans); color: var(--heading); text-decoration: none; transition: background-color 0.2s var(--ease), color 0.2s var(--ease); }
  .truths-index a:hover { background: var(--navy); color: #fff; border-color: var(--navy); }
  .truths-links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }

  @media (max-width: 1000px) {
    .plain, .truths { grid-template-columns: 1fr; }
    .truths-aside { position: static; }
    .truths-index { display: none; }
  }
</style>
