---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { isPlaceholderText } from '../data/copy';
import { site } from '../data/site';
import { img, url } from '../lib/url';

const leaders = (await getCollection('leaders')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Leadership" description="The people who lead The Well Assembly of God." image="images/chapel.jpg">
  <PageHero kicker="Our team" title="Shepherds who serve." deck="Our pastors and leaders are called to love God, preach His Word, and care for the people of The Well." />
  <section class="section" style="padding-top: 1rem;">
    {site.preview && <div class="wrap"><p class="fine" style="margin-bottom: 1.8rem;">Names, photographs, and biographies are coming soon.</p></div>}
    <div class="wrap people">
      {
        leaders.map((entry) => (
          <article>
            <img src={img(entry.data.image)} alt={entry.data.alt} loading="lazy" />
            <p class="eyebrow" style="margin-top: 1rem;">{entry.data.focus}</p>
            <h2 class="card-title">{entry.data.name}</h2>
            <p class="fine" style="margin-top: 0.55rem;">{isPlaceholderText(entry.data.summary) ? 'Biography coming soon.' : entry.data.summary}</p>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section" style="padding-top: 0;"><div class="wrap measure"><p class="eyebrow">Need a pastor?</p><h2 class="block-title">We’re here for you.</h2><p class="deck" style="margin-top: 1rem;">For prayer, counsel, a hospital visit, a wedding, a baby dedication, or simply a conversation about faith, reach out. A pastor will get back to you.</p><div class="actions"><a class="btn" href={url('/contact')}>Contact a pastor <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
