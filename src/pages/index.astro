---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import EventList from '../components/EventList.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import MessageCard from '../components/MessageCard.astro';
import MinistryCard from '../components/MinistryCard.astro';
import Photo from '../components/Photo.astro';
import Scripture from '../components/Scripture.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceTimes from '../components/ServiceTimes.astro';
import { cardinal } from '../data/beliefs';
import { midweek, prayerMeeting, site, sunday, sundaySchool } from '../data/site';
import { upcomingEvents } from '../lib/events';
import { loadSocial } from '../lib/feeds';
import { iso, longDate, todayIso } from '../lib/format';
import { img, photoFor, url } from '../lib/url';

const ministries = (await getCollection('ministries')).sort((a, b) => a.data.order - b.data.order);
const events = (await upcomingEvents()).slice(0, 3);
const [note] = (await getCollection('announcements'))
  .filter((entry) => iso(entry.data.expires) >= todayIso())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const social = await loadSocial();
const sermons = (await getCollection('sermons')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Latest messages: YouTube uploads when the feed is connected, otherwise the sermon-notes library.
const messages = social.videos.length
  ? social.videos.slice(0, 4).map((video) => ({ href: `/watch/${video.id}`, image: video.thumbnail, title: video.title, meta: longDate(new Date(video.published)), video: true }))
  : sermons.slice(0, 4).map((entry) => ({ href: `/sermons/${entry.id}`, image: photoFor(entry.data), title: entry.data.title, meta: `${entry.data.passage} · ${longDate(entry.data.date)}`, video: Boolean(entry.data.video) }));
const [featured, ...recent] = messages;

const firstVisit = [
  { icon: 'clock', title: `${site.serviceLength[0].toUpperCase()}${site.serviceLength.slice(1)}`, text: `Worship, a Bible message, and prayer. ${sundaySchool.name} for every age meets the hour before.` },
  { icon: 'shirt', title: 'Come as you are', text: 'Jeans or Sunday best. No one will single you out or ask you to stand.' },
  { icon: 'kids', title: 'Kids are covered', text: 'Safe check-in and Bible lessons made for nursery through 5th grade.' },
  { icon: 'flame', title: 'Spirit-filled worship', text: 'Heartfelt songs, practical preaching, and an open altar for prayer.' },
] as const;
---

<Base title="Home" description={`${site.legal} is a Spirit-filled, Bible-based church in ${site.locality}, Oklahoma. Join us ${sunday.day}s at ${sunday.time}. Come as you are and meet Jesus.`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap-wide hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.affiliation} · {site.locality}, Oklahoma</p>
        <h1 id="hero-title">A place to <em>belong.</em><br />A faith to grow.</h1>
        <p class="lede">We are a Spirit-filled church family. Wherever you are in your journey, Jesus is ready to meet you, and so are we.</p>
        <div class="hero-actions">
          <Button href="/visit" size="lg">Plan your visit</Button>
          <Button href="/watch" variant="secondary" size="lg" leading="play" icon="none">Watch online</Button>
        </div>
        <div class="hero-times">
          <ServiceTimes days={['Sunday']} />
          <p class="hero-midweek">Also {prayerMeeting.day}s at {prayerMeeting.time} for prayer and {midweek.day}s at {midweek.time} for midweek service.</p>
          <a class="hero-address" href={site.mapsHref}><Icon name="pin" size={18} />{site.address}, {site.city}</a>
        </div>
      </div>
      <figure class="hero-media">
        <Photo src={img('church')} alt="The Well Assembly of God: a long brick building with a red metal roof and a covered front entrance, at sunset." sizes="(min-width: 1000px) 45vw, 100vw" priority />
        <figcaption>The door is open. Come thirsty.</figcaption>
      </figure>
    </div>
  </section>

  <Section labelledby="visit-title">
    <SectionHeader id="visit-title" align="split" eyebrow="Your first Sunday" title="Come as you are." accent="We’ll save you a seat." lede="Visiting a church for the first time can feel like a big step. Here is what to expect, so you can walk in feeling at home." action={{ href: '/visit', label: 'Everything about your visit' }} />
    <FeatureGrid items={firstVisit} columns={4} variant="cards" />
  </Section>

  <Section tone="sand" width="wide" labelledby="story-title">
    <div class="story" data-reveal>
      <div class="story-media">
        <Photo src={img('water')} alt="Morning light on the rippling surface of water in a stone well." sizes="(min-width: 1000px) 40vw, 100vw" />
      </div>
      <div class="story-copy">
        <p class="eyebrow">Who we are</p>
        <h2 id="story-title">Where thirsty people <em>meet Jesus.</em></h2>
        <p class="lede">At a well in Samaria, Jesus offered a thirsty woman living water. That invitation is why our church exists. We are a Pentecostal church in the {site.affiliation}, and four convictions sit at the heart of our faith.</p>
        <ul class="convictions" role="list">
          {cardinal.map((item) => <li><strong>{item.title}</strong><span>{item.text}</span></li>)}
        </ul>
        <div class="story-actions">
          <Button href="/about" variant="secondary">Our story</Button>
          <Button href="/beliefs" variant="text">What we believe</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section width="wide" labelledby="ministries-title">
    <SectionHeader id="ministries-title" align="split" eyebrow="For every generation" title="Find your people." lede="From the nursery to the grandparents, there is a place at The Well for you to know Jesus and grow." action={{ href: '/ministries', label: 'All ministries' }} />
    <div class="ministry-grid swipe-row" data-reveal>
      {ministries.map((entry) => <MinistryCard entry={entry} />)}
    </div>
  </Section>

  {featured && (
    <Section tone="navy" width="wide" labelledby="watch-title">
      <SectionHeader id="watch-title" align="split" eyebrow="Watch" title="A word for your week." lede={`Missed a ${sunday.day}? Catch up on a recent message, or worship with us live at ${sunday.time}.`} action={{ href: '/watch', label: 'All messages' }} />
      <div class="watch-grid" data-reveal>
        <MessageCard {...featured} size="lg" eyebrow="Latest message" />
        {recent.length > 0 && (
          <ul class="watch-recent" role="list">
            {recent.map((message) => <li><MessageCard {...message} /></li>)}
          </ul>
        )}
      </div>
    </Section>
  )}

  <Section labelledby="events-title">
    <SectionHeader id="events-title" align="split" eyebrow="Coming up" title="Life at The Well." lede="Church is more than a Sunday service. Here is what is coming up and where to plug in." action={{ href: '/events', label: 'Full calendar' }} />
    <div class="events-layout" data-reveal>
      {events.length > 0 ? <EventList events={events} compact /> : <ServiceTimes variant="cards" />}
      {note && (
        <aside class="announcement" aria-label="Church update">
          <p class="ref">Church update</p>
          <p>{note.data.summary}</p>
        </aside>
      )}
    </div>
  </Section>

  <Section tone="navy" width="narrow" labelledby="invite-title" class="invite">
    <div class="invite-inner" data-reveal>
      <p class="eyebrow" id="invite-title">An invitation</p>
      <Scripture text="If anyone thirsts, let him come to Me and drink." reference="John 7:37" size="lg" align="center" />
      <p class="lede">Whoever you are and wherever you have been, Jesus offers you forgiveness, new life, and a family. You can begin today.</p>
      <div class="invite-actions">
        <Button href="/jesus" size="lg">Begin with Jesus</Button>
        <Button href="/prayer" variant="text">Ask for prayer</Button>
      </div>
    </div>
  </Section>
</Base>

<style>
  .hero { padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2rem, 4vw, 3.5rem); }
  .hero + :global(.section) { padding-top: calc(var(--section) * 0.45); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .hero-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .hero h1 { font-size: clamp(3rem, 1.8rem + 4.6vw, 5.75rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-times { display: grid; gap: 1rem; width: 100%; max-width: 34rem; margin-top: 1rem; }
  .hero-midweek { color: var(--fg-muted); font-size: 0.92rem; }
  .hero-address { display: inline-flex; align-items: center; gap: 0.5rem; justify-self: start; min-height: 44px; color: var(--fg-muted); font-size: 0.95rem; text-decoration: none; }
  .hero-address :global(.icon) { color: var(--accent-ink); }
  .hero-address:hover { color: var(--heading); text-decoration: underline; }
  .hero-media { position: relative; margin: 0; overflow: hidden; aspect-ratio: 1; max-height: calc(100svh - var(--header-h) - 4rem); border-radius: 999px 999px var(--radius-lg) var(--radius-lg); background: var(--sand-2); }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .hero-media::after { content: ''; position: absolute; inset: 55% 0 0; background: linear-gradient(transparent, rgb(0 30 48 / 70%)); }
  .hero-media figcaption { position: absolute; z-index: 1; left: 1.75rem; bottom: 1.5rem; color: #fff; font: italic 500 1.1rem var(--serif); }

  .story { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .story-media { overflow: hidden; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); }
  .story-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .story-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .convictions { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 2rem; width: 100%; }
  .convictions li { display: grid; gap: 0.3rem; padding-top: 1rem; border-top: 1px solid var(--line-strong); }
  .convictions strong { font: 500 1.2rem / 1.25 var(--serif); color: var(--heading); }
  .convictions span { color: var(--fg-muted); font-size: 0.93rem; }
  .story-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }

  .ministry-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 1240px) { .ministry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .watch-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: center; }
  .watch-recent { display: grid; gap: 1.25rem; }
  .watch-recent :global(.message-card) { grid-template-columns: 9.5rem 1fr; align-items: center; gap: 1rem; }

  .events-layout { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .announcement { display: grid; gap: 0.6rem; padding: 1.5rem; border-left: 3px solid var(--gold); border-radius: 0 var(--radius) var(--radius) 0; background: var(--sand); }
  .announcement p:last-child { font: 500 1.2rem / 1.4 var(--serif); color: var(--heading); }

  .invite-inner { display: grid; gap: 1.75rem; justify-items: center; text-align: center; }
  .invite-inner .lede { margin-inline: auto; }
  .invite-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.5rem; }

  @media (max-width: 1000px) {
    .hero-grid, .story, .watch-grid, .events-layout { grid-template-columns: 1fr; }
    /* The building leads on small screens, so the first view always shows the church. */
    .hero-media { order: -1; aspect-ratio: 16 / 9; max-height: 34svh; width: 100%; border-radius: 12rem 12rem var(--radius-lg) var(--radius-lg); }
    .hero-media figcaption { display: none; }
    .story-media { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 1rem; }
    .hero-grid { gap: 1.5rem; }
    .hero-copy { gap: 1.25rem; }
    .hero h1 { font-size: clamp(2.6rem, 11vw, 3.4rem); }
    .hero-actions { width: 100%; }
    .hero-actions > :global(*) { flex: 1 1 100%; }
    .hero-times { margin-top: 0.25rem; }
    .convictions { grid-template-columns: 1fr; }
    .watch-recent :global(.message-card) { grid-template-columns: 7.5rem 1fr; }
  }
</style>
