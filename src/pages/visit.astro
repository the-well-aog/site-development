---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderForm from '../components/PlaceholderForm.astro';
import { site } from '../data/site';
import { img, url } from '../lib/url';

const questions = [
  { title: 'What is a service like?', text: `Our ${site.sundayLabel} service starts at ${site.sundayTime} and lasts ${site.serviceLength}. We begin with heartfelt worship: contemporary songs, a live band, and people who love to praise God. Some lift their hands, some sing quietly; you are free to simply listen. Then a pastor preaches a practical, Bible-centered message, and we close with a time of prayer at the altar for anyone who wants it.`, href: '/beliefs', label: 'What we believe' },
  { title: 'What should I wear?', text: 'Whatever you are comfortable in. You will see jeans and you will see Sunday best. God looks at the heart, and so do we.', href: '/contact', label: 'Ask us anything' },
  { title: 'What about my kids?', text: 'Children are a gift, and we love having them here. Kids ministry runs during the Sunday service for nursery through elementary, with safe check-in, screened volunteers, and Bible lessons made for their age. Students meet on Wednesday nights.', href: '/ministries/kids', label: 'Explore Kids' },
  { title: 'Will I be singled out?', text: 'No. We will not ask you to stand up or speak. A greeter will welcome you at the door, help you find a seat or the kids area, and answer any questions, and that is it.', href: '/contact', label: 'Ask about your visit' },
  { title: 'I have heard Pentecostals pray in tongues. What should I expect?', text: 'We believe the gifts of the Holy Spirit described in the Bible are for today, and you may hear someone pray in tongues or sense a moment of quiet expectation during worship or prayer. Scripture tells us everything should be done decently and in order (1 Corinthians 14:40), and our pastors guide every service with care. If something is new to you, ask; we love talking about it.', href: '/next-steps#holy-spirit', label: 'The Holy Spirit and you' },
  { title: 'Do I have to give?', text: 'No. Giving is an act of worship for our church family, and guests are never expected to give. Please receive the service as our gift to you.', href: '/give', label: 'About giving' },
  { title: 'Where do I park and enter?', text: `We are at ${site.address} in ${site.locality}, with parking right beside the building. Enter through the covered front entrance and a greeter will meet you. If you need step-free access or help getting in, call ahead and we will be ready for you.`, href: '/contact', label: 'Get arrival help' },
];
---

<Base title="Plan your visit" description="Find gathering times, explore Kids, and plan your first visit to The Well Assembly of God." image="images/church-exterior.jpg">
  <PageHero kicker="Your first Sunday" title="Come as you are." deck="A new church can come with a lot of questions. Here is everything you need to feel at home before you walk through the door." />
  <section class="visit-at-a-glance" aria-label="Gathering times and location">
    <div class="wrap">
      <dl class="facts">
        <div><dt>{site.sundayLabel}</dt><dd>{site.sundayTime}<small>{site.sundayDetail}</small></dd></div>
        <div><dt>{site.midweekLabel}</dt><dd>{site.midweekTime}<small>{site.midweekDetail}</small></dd></div>
        <div><dt>Find us</dt><dd><a href={site.mapsHref}>{site.address}</a><small>{site.city}</small><a href={site.phoneHref}>{site.phoneDisplay}</a></dd></div>
      </dl>
      {site.preview && <p class="fine preview-note">Service times are awaiting final confirmation. Call ahead if you want to be sure.</p>}
      <nav class="actions" aria-label="Plan your visit">
        <a class="btn" href="#first-visit">What to expect <span aria-hidden="true">↓</span></a>
        <a class="more" href={url('/ministries/kids')}>Coming with kids? <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </section>
  <figure class="page-figure">
    <img class="is-church" src={img('church')} alt="The church at golden hour: a long brick building with a red metal roof, a gravel lot, and the covered entrance." width="1254" height="1254" />
  </figure>
  <section class="section" id="first-visit">
    <div class="wrap visit-questions">
      <div>
        <p class="eyebrow">Before you arrive</p>
        <h2 class="block-title">A little more<br />peace of mind.</h2>
        <p class="deck">Honest answers to the questions most guests ask.</p>
      </div>
      <div class="faq-list">
        {questions.map((question, index) => (
          <details open={index === 0}>
            <summary>{question.title}<span aria-hidden="true">+</span></summary>
            <div class="faq-answer">
              <p>{question.text}</p>
              <a class="more" href={url(question.href)}>{question.label} <span aria-hidden="true">→</span></a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section visit-connect">
    <div class="wrap contact-grid">
      <div class="measure">
        <p class="eyebrow">Start a conversation</p>
        <h2 class="block-title">Let us know<br />you’re coming.</h2>
        <p class="deck">Tell us a little about yourself and we will have someone watching for you at the door, ready to help with kids check-in and save you a seat.</p>
        <div class="actions"><a class="more" href={url('/contact')}>Contact information <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="panel">
        <h2 class="card-title form-title">Plan a first visit</h2>
        <PlaceholderForm submit="Preview your note">
          <label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label class="field"><span>Number of guests</span><input name="party" type="number" min="1" inputmode="numeric" /></label>
          <label class="field"><span>Questions about your visit</span><textarea name="note" rows="4"></textarea></label>
        </PlaceholderForm>
      </div>
    </div>
  </section>
</Base>

<style>
  .visit-at-a-glance { padding-bottom: 3rem; }
  .visit-at-a-glance .facts { margin-top: 0; margin-bottom: .7rem; }
  .facts dd small, .facts dd a { display: block; }
  .facts dd a { color: inherit; text-decoration: none; }
  .facts dd a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .facts dd small, .facts dd a[href^='tel:'] { font: .95rem var(--sans); letter-spacing: 0; color: var(--muted); margin-top: .5rem; }
  .preview-note { max-width: 48ch; }
  .visit-questions { display: grid; grid-template-columns: .85fr 1.15fr; gap: 4rem; align-items: start; }
  .visit-questions .deck, .visit-connect .deck { margin-top: 1.2rem; }
  .visit-connect { padding-top: 0; }
  .visit-connect .fine { margin-top: 1rem; }
  .faq-list details { border-top: 1px solid var(--line); }
  .faq-list details:last-child { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; cursor: pointer; padding: 1.4rem 0; font-size: 1.08rem; font-weight: 500; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { flex: none; color: var(--tide); font-size: 1.5rem; transition: transform .2s; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-answer { padding: 0 0 1.4rem; }
  .faq-answer p { color: var(--muted); max-width: 55ch; }
  .faq-answer .more { display: inline-flex; margin-top: 1rem; }
  .form-title { margin: 0 0 1.3rem; }
  @media (max-width: 800px) { .visit-questions { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }
  @media (max-width: 680px) {
    .visit-at-a-glance .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .25rem 1rem; }
    .visit-at-a-glance .facts > div:last-child { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .faq-list summary span { transition: none; } }
</style>
