---
import Base from '../layouts/Base.astro';
import Accordion from '../components/Accordion.astro';
import Button from '../components/Button.astro';
import ContactOptions from '../components/ContactOptions.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import VisitPlanner from '../components/VisitPlanner.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceTimes from '../components/ServiceTimes.astro';
import { midweek, prayerMeeting, site, sunday, sundaySchool } from '../data/site';
import { img } from '../lib/url';

const sundayFlow = [
  { icon: 'door', title: 'Arrive and park', text: `Park beside the building and come in through the covered front entrance. ${sundaySchool.name} classes start at ${sundaySchool.time}; worship begins at ${sunday.time}.` },
  { icon: 'kids', title: 'Take the kids to class', text: 'A greeter will show you where the kids classes meet. Children from nursery through 5th grade have their own space and lesson.' },
  { icon: 'flame', title: 'Worship together', text: 'Contemporary songs with a live band. Sing out, lift your hands, or simply listen. You are welcome either way.' },
  { icon: 'book', title: 'Hear the Word', text: 'A pastor preaches a practical, Bible-centered message for everyday life.' },
  { icon: 'hands', title: 'Pray at the altar', text: 'We close with an open altar. Anyone who wants prayer can come forward, and someone will pray with you.' },
  { icon: 'coffee', title: 'Stay and say hello', text: 'After service, grab a coffee and meet a pastor. We would love to learn your name.' },
] as const;

const questions = [
  { title: 'What should I wear?', text: 'Whatever you are comfortable in. You will see jeans and you will see Sunday best. God looks at the heart, and so do we.' },
  { title: 'Will I be singled out?', text: 'No. We will not ask you to stand up or say anything. A greeter will welcome you, help you find a seat or the kids area, and answer your questions.' },
  { title: 'I have heard Pentecostals pray in tongues. What should I expect?', text: 'We believe the gifts of the Holy Spirit described in the Bible are for today, so you may hear someone pray in tongues or sense a moment of quiet expectation during worship. Scripture tells us everything should be done decently and in order (1 Corinthians 14:40), and our pastors guide every service with care. If something is new to you, ask. We love talking about it.', link: { href: '/next-steps#holy-spirit', label: 'The Holy Spirit and you' } },
  { title: 'Do I have to give?', text: 'No. Giving is an act of worship for our church family, and guests are never expected to give. Please receive the service as our gift to you.' },
  { title: 'Is the building accessible?', text: 'Parking is right beside the entrance. If you need step-free access or a hand getting in, call ahead and we will be ready for you.' },
  { title: 'What happens during the week?', text: `We gather for a ${prayerMeeting.name.toLowerCase()} on ${prayerMeeting.day}s at ${prayerMeeting.time} and for our ${midweek.day} service at ${midweek.time}. Both are a great second step after a ${sunday.day} visit.` },
  { title: 'Is there something before the service?', text: `Yes. ${sundaySchool.name} meets at ${sundaySchool.time}, with Bible classes for every age. You are welcome to come for both, or just for worship at ${sunday.time}.` },
];
---

<Base title="Plan your visit" description={`Service times, directions, and what to expect on your first Sunday at ${site.legal} in ${site.locality}, Oklahoma.`}>
  <PageHeader
    eyebrow="Plan your visit"
    title="Come as you are."
    lede="A new church can come with a lot of questions. Here is everything you need to feel at home before you walk through the door."
    image={{ src: img('worship'), alt: 'The sanctuary at The Well: a carpeted platform with a wooden pulpit, a grand piano, guitars, and a cross draped in purple.', position: 'center 40%' }}
  />

  <Section labelledby="when-title">
    <h2 id="when-title" class="sr-only">When and where</h2>
    <div class="glance" data-reveal>
      <ServiceTimes variant="cards" />
      <div class="location tone-navy">
        <div>
          <p class="location-label">Find us</p>
          <p class="location-address">{site.address}, {site.city}</p>
        </div>
        <div class="location-actions">
          <Button href={site.mapsHref} leading="pin" icon="none">Get directions</Button>
          <Button href={site.phoneHref} variant="secondary" leading="phone" icon="none">{site.phoneDisplay}</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section label="Plan your Sunday">
    <VisitPlanner />
  </Section>

  <Section tone="sand" width="wide" labelledby="flow-title">
    <SectionHeader id="flow-title" align="split" eyebrow={`Your first ${sunday.day}`} title="What the morning looks like." lede={`From the parking lot to the last song, here is how a ${sunday.day} at The Well usually goes.`} />
    <ol class="flow" role="list" data-reveal>
      {sundayFlow.map((step, index) => (
        <li>
          <span class="flow-icon"><Icon name={step.icon} size={22} /></span>
          <span class="flow-step">Step {index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section width="wide" labelledby="kids-title">
    <div class="kids" data-reveal>
      <div class="kids-media tint"><Photo src={img('youth')} alt="Students from The Well smiling around a dinner table in the fellowship hall." sizes="(min-width: 1000px) 50vw, 100vw" /></div>
      <div class="kids-copy">
        <p class="eyebrow">Coming with kids?</p>
        <h2 id="kids-title">Your kids will love it here.</h2>
        <p class="lede">While you worship, your children worship too, in kids classes with Bible lessons made for their age. Our security team is on site during every service.</p>
        <Button href="/ministries/kids" variant="secondary">About The Well Kids</Button>
      </div>
    </div>
  </Section>

  <Section labelledby="faq-title">
    <div class="faq">
      <div class="faq-head">
        <SectionHeader id="faq-title" eyebrow="Good questions" title="Before you come." lede="Honest answers to what most guests wonder about." />
      </div>
      <Accordion items={questions} open={0} />
    </div>
  </Section>

  <Section tone="sand" id="hello" labelledby="hello-title">
    <div class="hello">
      <div class="hello-copy" data-reveal>
        <p class="eyebrow">Let us know you’re coming</p>
        <h2 id="hello-title">We’ll watch for you at the door.</h2>
        <p class="lede">Tell us you are coming and someone will be ready to welcome you, show your kids to their classes, and save you a seat.</p>
      </div>
      <ContactOptions title="Say hello before Sunday" subject="Planning a visit" submit="Let us know" directions>
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>How many are coming?<input name="party" type="number" min="1" inputmode="numeric" /></label>
        <label>Ages of any kids, or questions<textarea name="note" rows="3"></textarea></label>
      </ContactOptions>
    </div>
  </Section>
</Base>

<style>
  .glance { display: grid; gap: clamp(1.75rem, 3vw, 2.5rem); }
  .location { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding: clamp(1.5rem, 3vw, 2rem); border-radius: var(--radius); background: var(--bg); color: var(--fg); }
  .location-label { font: 600 0.72rem / 1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-muted); }
  .location-address { font: 500 1.6rem / 1.25 var(--serif); letter-spacing: -0.02em; }
  .location-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; counter-reset: none; }
  .flow li { display: grid; align-content: start; gap: 0.6rem; padding: 1.6rem; border-radius: var(--radius); background: var(--paper); border: 1px solid var(--line); }
  .flow-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--navy); color: #fff; }
  .flow-step { margin-top: 0.5rem; font: 600 0.68rem / 1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-ink); }
  .flow h3 { font-size: 1.4rem; }
  .flow p { color: var(--fg-muted); font-size: 0.95rem; }

  .kids { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .kids-media { overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); }
  .kids-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .kids-copy { display: grid; gap: 1.25rem; justify-items: start; }

  .faq { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .faq-head { position: sticky; top: calc(var(--header-h) + 2rem); }

  .hello { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .hello-copy { display: grid; gap: 1.25rem; }

  @media (max-width: 1000px) {
    .kids, .faq, .hello { grid-template-columns: 1fr; }
    .faq-head { position: static; }
    .flow { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .flow { grid-template-columns: 1fr; }
  }
</style>
